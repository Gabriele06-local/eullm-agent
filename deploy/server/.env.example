# Copy to .env and fill in. Generate passwords and tokens with:
#   openssl rand -hex 32

# Release whose images to run (for example 0.5.3); latest when empty.
# To update: change it, then docker compose pull && docker compose up -d
EULLM_VERSION=
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
EDITOR_OWNER_DB_PASSWORD=
EDITOR_WEB_DB_PASSWORD=

# Tokens of the Core API: Editor Mode's, and one for you (Core web interface).
EDITOR_CORE_TOKEN=
CORE_ADMIN_TOKEN=

# Key of the publishing credentials (WordPress, webhook, Telegram) that
# owners enter in the dashboard: they are stored encrypted with it. Generate
# with `openssl rand -base64 32` and keep a copy: without it they cannot be
# read and must be entered again.
EDITOR_SECRET_KEY=

# API key of the model provider, if core.yaml uses api_key_env: LLM_API_KEY
LLM_API_KEY=

# Optional, for a start with docker compose up -d alone: the administrator
# (you) created at the first start, and a first newsroom owned by it. Once
# you have signed in, empty EDITOR_ADMIN_PASSWORD: it is not used again.
# server-init asks for these and does not write them here.
EDITOR_ADMIN_EMAIL=
EDITOR_ADMIN_PASSWORD=
EDITOR_FIRST_NEWSROOM=

# Where the ports listen. Keep 127.0.0.1 and put a reverse proxy with HTTPS
# in front; 0.0.0.0 exposes them without encryption.
BIND=127.0.0.1
CORE_PORT=8088
EDITOR_PORT=8090

# The address people open the dashboard at, behind the reverse proxy (for
# example https://editor.example.com): the links of invites and password
# resets point there.
EDITOR_PUBLIC_URL=

EDITOR_TIMEZONE=Europe/Rome
# Tenants the worker runs at the same time (one job per tenant).
EDITOR_WORKER_CONCURRENCY=2
# Collected items and finished jobs older than this are deleted (0 keeps all).
EDITOR_RETENTION_DAYS=365
# Email (STARTTLS) for the briefing, invites and password resets, and
# Telegram, optional. Without SMTP the invite links are shown to whoever
# creates them, to send by hand.
EDITOR_SMTP_HOST=
EDITOR_SMTP_PORT=587
EDITOR_SMTP_USER=
EDITOR_SMTP_PASSWORD=
EDITOR_MAIL_FROM=
EDITOR_TELEGRAM_TOKEN=
