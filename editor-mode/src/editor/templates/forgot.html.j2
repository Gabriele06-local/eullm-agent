<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Password dimenticata') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="Redazia" width="111" height="36"></div>
  <section class="card pad">
    <h1 style="font-size: 22px;">{{ _('Password dimenticata') }}</h1>
    {% if sent %}
    <p class="lead">{{ _("Se l'indirizzo ha un account, è partita un'email con il link per scegliere una nuova password. Il link vale 24 ore.") }}</p>
    <a class="btn" href="/login">{{ _("Torna all'accesso") }}</a>
    {% elif can_reset %}
    <p class="lead">{{ _('Ti mandiamo un link per scegliere una nuova password.') }}</p>
    <form method="post" action="/forgot" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">{{ _('Email') }}<input name="email" type="email" autocomplete="username" required autofocus></label>
      <button class="btn pri" type="submit">{{ _('Manda il link') }}</button>
    </form>
    {% else %}
    <p class="lead">{{ _('Questo server non manda email: chiedi un nuovo link a chi gestisce il servizio.') }}</p>
    <a class="btn" href="/login">{{ _("Torna all'accesso") }}</a>
    {% endif %}
  </section>
  {% include "_lang.html.j2" %}
</main>
</body>
</html>
