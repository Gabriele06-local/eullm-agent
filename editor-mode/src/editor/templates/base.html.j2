<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Editor Mode{% endblock %} · EuLLM Editor</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<div class="shell">
<nav class="nav" aria-label="Sezioni">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="EuLLM" width="130" height="36"><small>Editor Mode</small></div>
  {% if newsrooms|length > 1 %}
  <form method="get" action="/newsroom" class="switch">
    <label for="room-pick">Redazione</label>
    <select id="room-pick" name="t" onchange="this.form.submit()">
      {% for x in newsrooms %}<option value="{{ x.tenant_id }}" {% if x.tenant_id == caller.tenant_id %}selected{% endif %}>{{ x.name }}</option>{% endfor %}
      {% if caller.tenant_id not in newsrooms|map(attribute='tenant_id') %}<option value="{{ caller.tenant_id }}" selected>{{ caller.tenant_id }}</option>{% endif %}
    </select>
    <noscript><button class="btn sm" type="submit">Vai</button></noscript>
  </form>
  {% endif %}
  {% if sites %}
  <form method="get" action="/switch" class="switch">
    <label for="site-pick">Sito</label>
    <select id="site-pick" name="site" onchange="this.form.submit()">
      {% for x in sites %}<option value="{{ x.id }}" {% if site and x.id == site.id %}selected{% endif %}>{{ x.domain }}</option>{% endfor %}
    </select>
    <input type="hidden" name="back" value="{{ request.url.path }}">
    <noscript><button class="btn sm" type="submit">Vai</button></noscript>
  </form>
  {% endif %}
  <a href="/" {% if active == 'today' %}class="on" aria-current="page"{% endif %}>Oggi</a>
  <a href="/site" {% if active == 'site' %}class="on" aria-current="page"{% endif %}>Sito e profilo</a>
  <a href="/sources" {% if active == 'sources' %}class="on" aria-current="page"{% endif %}>Fonti</a>
  <a href="/trends" {% if active == 'trends' %}class="on" aria-current="page"{% endif %}>Trend e piano</a>
  <a href="/drafts" {% if active == 'drafts' %}class="on" aria-current="page"{% endif %}>Bozze</a>
  <a href="/publications" {% if active == 'publications' %}class="on" aria-current="page"{% endif %}>Pubblicazioni</a>
  <span class="grow"></span>
  <a href="/settings" {% if active == 'settings' %}class="on" aria-current="page"{% endif %}>Impostazioni</a>
  {% if caller.operator %}<a href="/admin">Amministrazione</a>{% endif %}
  <div class="who">
    <span>{{ caller.name }} · {{ {'owner': 'owner', 'editor': 'editor', 'viewer': 'lettura'}[caller.role] }}</span>
    <form method="post" action="/logout"><button class="link" type="submit">Esci</button></form>
  </div>
</nav>
<main class="main">
  {% if notice %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
  {% block main %}{% endblock %}
</main>
</div>
</body>
</html>
