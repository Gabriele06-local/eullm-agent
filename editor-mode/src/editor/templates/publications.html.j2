{% extends "base.html.j2" %}
{% block title %}{{ _('Pubblicazioni') }}{% endblock %}
{% block main %}
<header class="head">
  <div>
    <span class="kicker">{{ _('Pubblicazioni') }}{% if site %} · {{ site.domain }}{% endif %}</span>
    <h1>{{ _('Cosa esce, e dove') }}</h1>
    <p class="lead">{{ _('Un editor chiede, un owner approva. Nulla viene inviato al CMS o al canale senza quel sì.') }}</p>
  </div>
</header>
{% with page="publications" %}{% include "_help.html.j2" %}{% endwith %}

<section class="card" aria-labelledby="h-pending" style="gap: 0;">
  <div class="card-head"><h2 id="h-pending">{{ _('In attesa di approvazione') }}</h2><span class="hint">{{ pending|length }}</span></div>
  {% for p in pending %}
  <div class="item">
    <span class="chip amber">{{ _(kinds.get(p.kind, p.kind)) }}</span>
    <div class="what">
      <strong>{{ p.title }}</strong>
      <span>{{ _('Verso {target}', target=p.target) }} · {{ _('come bozza nel CMS') if p.mode == 'draft' else _('pubblicata subito') }} · {{ _('chiesta da {who} {when}', who=p.requested_by, when=when(p.requested_at)) }}</span>
    </div>
    <div class="row">
      <a class="btn" href="/drafts/{{ p.draft_id }}">{{ _('Leggi') }}</a>
      {% if caller.can('owner') %}
      <form class="inline" method="post" action="/ui/publications/{{ p.id }}/decision"><input type="hidden" name="accept" value="0"><button class="btn" type="submit">{{ _('Rifiuta') }}</button></form>
      <form class="inline" method="post" action="/ui/publications/{{ p.id }}/decision"><input type="hidden" name="accept" value="1"><button class="btn pri" type="submit">{{ _('Approva e invia') }}</button></form>
      {% endif %}
    </div>
  </div>
  {% else %}
  <p class="empty">{{ _('Nessuna richiesta in attesa.') }}</p>
  {% endfor %}
</section>

<section class="card" aria-labelledby="h-hist" style="gap: 0;">
  <div class="card-head"><h2 id="h-hist">{{ _('Storico') }}</h2></div>
  {% if history %}
  <div class="scroll">
    <table style="min-width: 680px;">
      <thead><tr><th>{{ _('Articolo') }}</th><th>{{ _('Destinazione') }}</th><th>{{ _('Chiesta da') }}</th><th>{{ _('Decisa da') }}</th><th>{{ _('Esito') }}</th></tr></thead>
      <tbody>
      {% for p in history %}
      <tr {% if p.status in ('failed', 'rejected') %}class="off"{% endif %}>
        <td style="max-width: 320px;"><a href="/drafts/{{ p.draft_id }}">{{ p.title }}</a></td>
        <td>{{ p.target }}<small>{{ _(kinds.get(p.kind, p.kind)) }} · {{ _('bozza') if p.mode == 'draft' else _('subito') }}</small></td>
        <td>{{ p.requested_by }}<small>{{ when(p.requested_at) }}</small></td>
        <td>{{ p.decided_by or '–' }}{% if p.decided_at %}<small>{{ when(p.decided_at) }}</small>{% endif %}</td>
        <td>
          {% set ps = {'approved': ('blue', _('In invio')), 'sending': ('blue', _('In invio')), 'published': ('green', _('Pubblicata')), 'rejected': ('', _('Rifiutata')), 'failed': ('red', _('Non riuscita'))}.get(p.status, ('', p.status)) %}
          {% if p.external_url %}<a class="chip {{ ps[0] }}" href="{{ p.external_url }}" rel="noopener noreferrer" target="_blank">{{ ps[1] }}</a>{% else %}<span class="chip {{ ps[0] }}">{{ ps[1] }}</span>{% endif %}
          {% if p.error %}<small>{{ p.error|truncate(120) }}</small>{% endif %}
          {% if p.status == 'sending' and p.uncertain %}
          <small>{{ _("Esito sconosciuto: l'invio si è interrotto. Controlla sul CMS prima di riprovare.") }}</small>
          {% if caller.can('owner') %}<form class="inline" method="post" action="/ui/publications/{{ p.id }}/uncertain"><button class="btn" type="submit">{{ _('Non è stata pubblicata') }}</button></form>{% endif %}
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty">{{ _('Ancora nessuna pubblicazione.') }}</p>
  {% endif %}
</section>

{% if site %}
<section class="card pad" aria-labelledby="h-targets">
  <h2 id="h-targets">{{ _('Destinazioni di {domain}', domain=site.domain) }}</h2>
  {% for t in targets %}
  <div class="list-row">
    <span><strong>{{ t.name }}</strong> <span class="chip">{{ _(kinds.get(t.kind, t.kind)) }}</span></span>
    <span class="hint num">{{ (t.config or {}).get('url') or (t.config or {}).get('repo') or (t.config or {}).get('chat_id') or '' }}{% if (t.config or {}).get('user') %} · {{ _('utente {user}', user=t.config.user) }}{% endif %}{% if t.secret_env %} · {% if t.secret_env in stored %}{{ _('credenziale {name} salvata cifrata', name=t.secret_env) }}{% else %}{{ _('credenziale in {var}', var=secret_var(t.secret_env)) }}{% endif %}{% endif %}{% if t.enabled is sameas false %} · {{ _('disattivata') }}{% endif %}</span>
  </div>
  {% if caller.can('owner') %}
  <details class="manage">
    <summary>{{ _('Modifica o elimina {name}', name=t.name) }}</summary>
    {% set cf = t.config or {} %}
    <form method="post" action="/ui/targets/{{ t.id }}" class="target-form">
      <div class="cols">
        <label class="field">{{ _('Nome') }}<input name="name" value="{{ t.name }}" required maxlength="100"></label>
        <label class="field">{{ _('Indirizzo') }}<input name="address" value="{{ (cf.get('repo') if t.kind == 'github' else cf.get('url') or cf.get('chat_id')) or '' }}" required></label>
        <label class="field">{{ _('Lingua degli articoli') }}<select name="language"><option value="">{{ _('Tutte (o la lingua del sito)') }}</option>{% for k, v in langs.items() %}<option value="{{ k }}" {% if cf.get('language') == k %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></label>
        {% if t.kind == 'wordpress' %}<label class="field">{{ _('Utente WordPress') }}<input name="user" value="{{ cf.get('user') or '' }}" autocomplete="off" required></label>{% endif %}
      </div>
      {% if t.kind == 'github' %}
      <div class="cols">
        <label class="field">{{ _('Ramo') }}<input name="branch" value="{{ cf.get('branch') or '' }}" autocomplete="off" placeholder="main"></label>
        <label class="field">{{ _('Cartella degli articoli') }}<input name="path" value="{{ cf.get('path') or '' }}" autocomplete="off" placeholder="content/blog"></label>
        <label class="field">{{ _('Cartella delle immagini') }}<input name="image_path" value="{{ cf.get('image_path') or '' }}" autocomplete="off" placeholder="{{ _('come negli articoli del sito') }}"></label>
        <label class="field">{{ _('Indirizzo degli articoli') }}<input name="article_url" value="{{ cf.get('url') or '' }}" autocomplete="off" placeholder="https://sito.it/blog/{slug}"></label>
      </div>
      {% endif %}
      <div class="cols">
        <label class="field">{{ _('Chiave IndexNow (facoltativa)') }}<input name="indexnow_key" value="{{ cf.get('indexnow_key') or '' }}" autocomplete="off"></label>
      </div>
      {% if t.kind == 'github' %}<label class="check"><input type="checkbox" name="verify" value="1" {% if cf.get('verify') is not sameas false %}checked{% endif %}> {{ _("Pubblica solo se il deploy di anteprima riesce (Vercel, Netlify)") }}</label>{% endif %}
      {% if t.kind == 'wordpress' %}<label class="check"><input type="checkbox" name="jsonld" value="1" {% if cf.get('jsonld') %}checked{% endif %}> {{ _('Aggiungi i dati strutturati JSON-LD (WordPress, utente amministratore)') }}</label>{% endif %}
      <label class="check"><input type="checkbox" name="enabled" value="1" {% if t.enabled is not sameas false %}checked{% endif %}> {{ _('Attiva: compare tra le destinazioni delle bozze') }}</label>
      <div><button class="btn pri" type="submit">{{ _('Salva') }}</button></div>
    </form>
    {% if t.secret_env %}
    <form method="post" action="/ui/secrets/{{ t.secret_env }}" class="form-grid">
      <label class="field">{{ _('Nuova credenziale {name}', name=t.secret_env) }}<input name="value" type="password" autocomplete="new-password" required></label>
      <div><button class="btn" type="submit">{{ _('Sostituisci') }}</button></div>
    </form>
    {% endif %}
    <form method="post" action="/ui/targets/{{ t.id }}/delete" class="row" onsubmit='return confirm({{ _('Eliminare {name}? Si cancella anche lo storico delle sue pubblicazioni; gli articoli già inviati restano sul sito.', name=t.name)|string|tojson }})'>
      <button class="btn danger sm" type="submit">{{ _('Elimina la destinazione') }}</button>
    </form>
  </details>
  {% endif %}
  {% else %}
  <p class="hint">{{ _('Nessuna destinazione: le bozze approvate restano qui finché non ne aggiungi una.') }}</p>
  {% endfor %}
  {% if caller.can('owner') %}
  <form method="post" action="/ui/targets" class="target-form">
    <input type="hidden" name="site_id" value="{{ site.id }}">
    <div class="cols">
      <label class="field">{{ _('Tipo') }}<select name="kind">{% for k, label in kinds.items() %}<option value="{{ k }}">{{ _(label) }}</option>{% endfor %}</select></label>
      <label class="field">{{ _('Nome') }}<input name="name" required placeholder="{{ _('Blog principale') }}"></label>
      <label class="field">{{ _('Indirizzo') }}<input name="address" placeholder="{{ _('https://…, owner/repo oppure @canale') }}"></label>
      <label class="field">{{ _('Lingua degli articoli') }}<select name="language"><option value="">{{ _('Tutte (o la lingua del sito)') }}</option>{% for k, v in langs.items() %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></label>
    </div>
    <div class="cols only-wordpress">
      <label class="field">{{ _('Utente WordPress') }}<input name="user" autocomplete="off" placeholder="{{ _('redazione') }}"></label>
    </div>
    <div class="cols only-github">
      <label class="field">{{ _('Ramo') }}<input name="branch" autocomplete="off" placeholder="main"></label>
      <label class="field">{{ _('Cartella degli articoli') }}<input name="path" autocomplete="off" placeholder="content/blog"></label>
      <label class="field">{{ _('Cartella delle immagini') }}<input name="image_path" autocomplete="off" placeholder="{{ _('come negli articoli del sito') }}"></label>
      <label class="field">{{ _('Indirizzo degli articoli') }}<input name="article_url" autocomplete="off" placeholder="https://sito.it/blog/{slug}"></label>
    </div>
    <div class="cols">
      <label class="field">{{ _('Nome della credenziale') }}<input name="secret_env" placeholder="WP_SITO"></label>
      <label class="field">{{ _('Credenziale') }}<input name="secret" type="password" autocomplete="new-password" placeholder="{{ _('password applicativa, chiave o token') }}"></label>
      <label class="field">{{ _('Chiave IndexNow (facoltativa)') }}<input name="indexnow_key" autocomplete="off" placeholder="{{ _('la stessa del file .txt nella radice del sito') }}"></label>
    </div>
    <label class="check only-github"><input type="checkbox" name="verify" value="1" checked> {{ _("Pubblica solo se il deploy di anteprima riesce (Vercel, Netlify)") }}</label>
    <label class="check only-wordpress"><input type="checkbox" name="jsonld" value="1"> {{ _('Aggiungi i dati strutturati JSON-LD (WordPress, utente amministratore)') }}</label>
    <div><button class="btn pri" type="submit">{{ _('Aggiungi la destinazione') }}</button></div>
  </form>
  <p class="hint">{{ _("Con la chiave IndexNow, ogni articolo pubblicato viene segnalato subito a Bing e ai motori che la usano, e da lì alle risposte AI che leggono il loro indice. Il file con la chiave va messo nella radice del sito, per esempio https://tuosito.it/CHIAVE.txt. Google non ha un avviso immediato per gli articoli: li trova dalla sitemap e dai link interni.") }}</p>
  <p class="hint">{{ _("La credenziale (password applicativa di WordPress, chiave del webhook, token del bot Telegram) viene salvata cifrata e non viene più mostrata: puoi solo sostituirla. In alternativa lasciala vuota e l'amministratore del server imposta la variabile EDITOR_SECRET_&lt;TENANT&gt;__&lt;NOME&gt;.") }}</p>
  <p class="hint">{{ _("GitHub: l'articolo approvato va nel repository come Markdown con front matter e copertina, e il sito (Vercel, GitHub Pages) pubblica da solo al commit. Come bozza apre una pull request, pubblicata subito committa nel ramo del sito. La credenziale è un token GitHub (fine-grained, solo quel repository, Contents in lettura e scrittura).") }}</p>
  {% endif %}
</section>
{% endif %}
{% endblock %}
