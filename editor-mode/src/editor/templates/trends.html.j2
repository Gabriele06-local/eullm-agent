{% extends "base.html.j2" %}
{% block title %}{{ _('Trend e piano') }}{% endblock %}
{% block main %}
<header class="head">
  <div>
    <span class="kicker">{{ _('Trend e piano') }}{% if site %} · {{ site.domain }}{% endif %}</span>
    <h1>{{ _('Cosa sale, e cosa conviene scrivere') }}</h1>
    <p class="lead">{{ _('Hype misura quanto un tema cresce nel settore. Opportunità misura quanto conviene a questo sito: vicinanza al profilo, copertura che manca, fonti solide.') }}</p>
  </div>
  {% if briefing_hour is not none %}<span class="chip">{{ _('Briefing ogni giorno alle {hour}:00', hour='%02d'|format(briefing_hour)) }}</span>{% endif %}
</header>
{% with page="trends" %}{% include "_help.html.j2" %}{% endwith %}

{% if not site %}
<section class="card pad"><h2>{{ _('Nessun sito') }}</h2><p class="lead">{{ _('Aggiungi un dominio da <a href="/site">Sito e profilo</a>.') }}</p></section>
{% else %}
<section class="card" id="moment" aria-labelledby="h-moment" style="gap: 0;">
  <div class="card-head"><h2 id="h-moment">{{ _('Il trend del momento') }}</h2>{% if snap %}<span class="hint">{{ _('aggiornato alle {time}', time=local(snap.taken_at).strftime('%H:%M')) }}</span>{% endif %}</div>
  <p class="hint" style="margin: 0; padding: 0 20px 12px;">{{ _("Ogni giorno alle 7:00, e poi ogni tre ore, l'archivio fissa i temi che crescono di più nel settore. Qui vedi quelli adatti a questo sito: scegli un titolo e l'agente scrive la bozza, oppure chiedi tre titoli tra cui scegliere.") }}</p>
  {% for x in moment %}
  <div class="item" style="align-items: flex-start;">
    <span class="chip blue">{{ _('Hype {n}', n=x.hype|s100) }}</span>
    <div class="what">
      <strong>{{ x.label }}</strong>
      <span class="hint">{{ x.sources|plural(_('fonte'), _('fonti')) }} · {{ x['items']|plural(_('notizia'), _('notizie')) }} · {{ _('opportunità {n}', n=x.opportunity|s100) }}</span>
      {% if x.summary %}<p style="margin: 4px 0;">{{ x.summary }}</p>{% endif %}
      <ul style="margin: 4px 0; padding-left: 18px;">
        {% for n in x.news %}<li><a href="{{ n.url }}" rel="noopener noreferrer" target="_blank">{{ n.title }}</a></li>{% endfor %}
      </ul>
      {% if x.titles %}
      <span class="kicker">{{ _('Titoli proposti: quale vuoi che scriva?') }}</span>
      {% for p in x.titles %}
      <div class="row" style="justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px solid var(--line);">
        <div style="display: flex; flex-direction: column; gap: 2px;"><span style="font-weight: 500;">{{ p.title }}</span>{% if p.angle %}<span class="hint">{{ p.angle }}</span>{% endif %}</div>
        {% if caller.can('editor') %}
        <form class="inline" method="post" action="/ui/proposals/{{ p.id }}"><input type="hidden" name="accept" value="1"><input type="hidden" name="back" value="/trends#moment"><button class="btn pri" type="submit">{{ _('Scrivi questo') }}</button></form>
        {% endif %}
      </div>
      {% endfor %}
      {% endif %}
    </div>
    {% if caller.can('editor') %}
    <form class="inline" method="post" action="/ui/trends/{{ x.topic_id }}/titles"><button class="btn" type="submit">{% if x.titles %}{{ _('Altri titoli') }}{% else %}{{ _('Proponimi tre titoli') }}{% endif %}</button></form>
    {% endif %}
  </div>
  {% else %}
  <p class="empty">{% if snap %}{{ _("Nel trend del momento non c'è un tema abbastanza vicino a questo sito. Il prossimo aggiornamento arriva entro tre ore.") }}{% else %}{{ _("Il primo trend arriva con la prossima raccolta: dalle 7:00, ogni tre ore.") }}{% endif %}</p>
  {% endfor %}
  {% if day %}
  <details style="padding: 0 20px 16px;">
    <summary class="hint">{{ _('Il trend di oggi, ora per ora') }}</summary>
    <ul style="margin: 8px 0; padding-left: 18px;">
      {% for d in day %}<li><strong>{{ local(d.taken_at).strftime('%H:%M') }}</strong> · {{ d.topics[:3]|map(attribute='label')|join(' · ') or _('nessun tema') }}</li>{% endfor %}
    </ul>
  </details>
  {% endif %}
</section>

<div class="cols">
  <section class="card pad col-wide" aria-labelledby="h-map">
    <h2 id="h-map">{{ _('Mappa dei temi') }}</h2>
    <p class="hint">{{ _('Ogni tema della settimana sta in uno dei quattro riquadri, secondo due punteggi da 0 a 100: Opportunità, quanto conviene a questo sito, e Hype, quanto se ne parla nel settore. La soglia è 50. Si scrive da «Scrivi ora» e «Nicchia utile».') }}</p>
    {% if dots %}
    {% set quads = [
      (_('Scrivi ora'), _('conviene al sito e se ne parla'), dots|selectattr('opportunity', 'ge', 50)|selectattr('hype', 'ge', 50)|list, 'green'),
      (_('Nicchia utile'), _('conviene al sito, se ne parla poco'), dots|selectattr('opportunity', 'ge', 50)|selectattr('hype', 'lt', 50)|list, 'blue'),
      (_('Rumore'), _('se ne parla, ma non è per il sito'), dots|selectattr('opportunity', 'lt', 50)|selectattr('hype', 'ge', 50)|list, 'amber'),
      (_('Ignora'), _('poco interesse e poco adatto'), dots|selectattr('opportunity', 'lt', 50)|selectattr('hype', 'lt', 50)|list, ''),
    ] %}
    <div class="quads" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px;">
      {% for name, what, items, color in quads %}
      <div class="dashed" style="display: flex; flex-direction: column; gap: 6px;">
        <div class="row" style="justify-content: space-between;"><strong>{{ name }}</strong><span class="chip {{ color }}">{{ items|length }}</span></div>
        <span class="hint">{{ what }}</span>
        {% for t in (items|sort(attribute='opportunity', reverse=true))[:5] %}
        <div style="display: flex; flex-direction: column; gap: 2px;">
          <div class="row" style="justify-content: space-between; gap: 8px; align-items: baseline;"><strong style="font-size: 14px; font-weight: 500;">{{ t.label }}</strong><span class="num hint" title="{{ _('opportunità · hype') }}">{{ t.opportunity|s100 }} · {{ t.hype|s100 }}</span></div>
          {% if t.headline %}<a class="hint" href="{{ t.headline_url }}" rel="noopener noreferrer" target="_blank">{{ t.headline|truncate(110) }}</a>{% endif %}
          <span class="hint">{{ t.items|plural(_('notizia'), _('notizie')) }} · {{ t.sources|plural(_('fonte'), _('fonti')) }}</span>
        </div>
        {% else %}
        <span class="hint">–</span>
        {% endfor %}
        {% if items|length > 5 %}<span class="hint">{{ _('e altri {n}', n=items|length - 5) }}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">{{ _('La mappa compare quando ci sono temi con entrambi i punteggi: serve un profilo approvato e almeno un giro di raccolta.') }}</p>
    {% endif %}
  </section>

  <section class="card col-side" aria-labelledby="h-topics" style="gap: 0;">
    <div class="card-head"><h2 id="h-topics">{{ _('Temi della settimana') }}</h2><span class="hint">{% if topics|length > 7 %}{{ _('primi 7 di {n}', n=topics|length) }}{% else %}{{ topics|length }}{% endif %}</span></div>
    <div class="pad" style="gap: 14px;">
      {% for t in topics[:7] %}
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <div class="row" style="justify-content: space-between;"><span style="font-size: 14px; font-weight: 500;">{{ t.label }}</span><span class="hint">{{ t.items|plural(_('notizia'), _('notizie')) }}</span></div>
        <div class="pair">
          <div class="bar"><i style="width: {{ (t.opportunity or 0)|round|int }}%"></i></div><span class="num">{{ t.opportunity|s100 }}</span>
          <div class="bar"><i class="hype" style="width: {{ (t.hype or 0)|round|int }}%"></i></div><span class="num" style="color: var(--muted);">{{ t.hype|s100 }}</span>
        </div>
      </div>
      {% else %}
      <p class="hint">{{ _('Nessun tema negli ultimi sette giorni.') }}</p>
      {% endfor %}
    </div>
  </section>
</div>

<section class="card" aria-labelledby="h-plan" style="gap: 0;">
  <div class="card-head"><h2 id="h-plan">{{ _('Piano editoriale') }}</h2>{% if caller.can('editor') %}<form class="inline" method="post" action="/ui/proposals/now"><button class="btn" type="submit">{{ _('Proponi adesso') }}</button></form>{% endif %}</div>
  <p class="hint" style="margin: 0; padding: 0 20px 12px;">{{ _("Ogni riga è l'idea di un articolo, non l'articolo. Le proposte arrivano ogni mattina all'ora del briefing ({hour}:00): prima i temi raccontati da almeno due fonti diverse, poi le notizie singole delle ultime 72 ore più adatte al sito, scelte dal modello; &quot;Proponi adesso&quot; non aspetta la mattina. <strong>Accetta e scrivi la bozza</strong> fa scrivere l'articolo, che rileggi in Bozze; <strong>Scarta</strong> la toglie e l'agente impara cosa non ti interessa. Opportunità (0-100) dice quanto il tema conviene a questo sito, Hype (0-100) quanto se ne parla nel settore. Nulla si pubblica senza il tuo sì.", hour='%02d'|format(briefing_hour or 8)) }}</p>
  {% for p in plan %}
  <div class="item">
    {% if p.status == 'proposed' %}<span class="chip">{{ _('Proposta') }}</span>{% elif p.status == 'accepted' and writing.get(p.id, {}).get('status') in ('queued', 'running') %}<span class="chip teal"><span class="spin" aria-hidden="true"></span>{{ _('Bozza in scrittura') }}</span>{% elif p.status == 'accepted' and writing.get(p.id, {}).get('status') == 'failed' %}<span class="chip red">{{ _('Bozza non riuscita') }}</span>{% elif p.status == 'accepted' %}<span class="chip blue">{{ _('Accettata') }}</span>{% else %}<span class="chip green">{{ _('Bozza pronta') }}</span>{% endif %}
    <div class="what">
      {% include "_proposal.html.j2" %}
      {% if writing.get(p.id, {}).get('status') == 'failed' %}<span class="note warn">{{ _('La bozza non è stata scritta: {error}', error=writing[p.id].error) }}</span>{% endif %}
    </div>
    <div class="row">
      {% if p.status == 'proposed' and caller.can('editor') %}
      <form class="inline" method="post" action="/ui/proposals/{{ p.id }}"><input type="hidden" name="accept" value="0"><button class="btn" type="submit">{{ _('Scarta') }}</button></form>
      <form class="inline" method="post" action="/ui/proposals/{{ p.id }}"><input type="hidden" name="accept" value="1"><button class="btn pri" type="submit">{{ _('Accetta e scrivi la bozza') }}</button></form>
      {% elif p.draft_id %}
      <a class="btn" href="/drafts/{{ p.draft_id }}">{{ _('Apri la bozza') }}</a>
      {% elif p.status == 'accepted' and writing.get(p.id, {}).get('status') in ('queued', 'running') %}
      <span class="hint">{{ _('La segui nel riquadro Attività.') }}</span>
      {% elif p.status == 'accepted' and caller.can('editor') and can_draft %}
      <form class="inline" method="post" action="/ui/proposals/{{ p.id }}/draft"><button class="btn pri" type="submit">{{ _('Scrivi la bozza') }}</button></form>
      {% elif p.status == 'accepted' %}
      <span class="hint">{{ _('In attesa di bozza') }}</span>
      {% endif %}
    </div>
  </div>
  {% else %}
  <p class="empty">{{ _('Nessuna proposta aperta. Le nuove arrivano con il briefing del mattino.') }}</p>
  {% endfor %}
</section>
{% endif %}
{% endblock %}
