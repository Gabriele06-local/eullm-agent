{% extends "base.html.j2" %}
{% block title %}Sito e profilo{% endblock %}
{% block main %}
{% macro job_panel() %}
{% if jobs %}
<div class="dashed"><strong>Lavori in coda, in corso o non riusciti</strong>{% for j in jobs %}<span class="hint">{{ {'analysis': 'Analisi', 'discovery': 'Ricerca fonti', 'draft': 'Bozza', 'maintain': 'Manutenzione fonti', 'review': 'Revisione settimanale', 'collect': 'Raccolta', 'briefing': 'Briefing', 'publish': 'Pubblicazione', 'tick': 'Giro orario'}.get(j.kind, j.kind) }}{% if j.subject %} ({{ j.subject }}){% endif %}: {% if j.status == 'running' %}in corso{% elif j.status == 'queued' %}in coda{% else %}non riuscito, {{ j.error }}{% endif %}</span>{% endfor %}</div>
{% endif %}
{% endmacro %}
{% if not site %}
<header class="head"><div><span class="kicker">Sito e profilo editoriale</span><h1>Nessun sito</h1></div></header>
{{ job_panel() }}
{% else %}
<header class="head">
  <div>
    <span class="kicker">Sito e profilo editoriale</span>
    <h1>{{ site.domain }}</h1>
    {% if analysis %}
    <div class="row">
      {% set st = {'complete': ('green', 'Analisi completa'), 'partial': ('amber', 'Analisi parziale'), 'insufficient': ('red', 'Dati insufficienti'), 'failed': ('red', 'Analisi fallita')}[analysis.status] %}
      <span class="chip {{ st[0] }}">{{ st[1] }}</span>
      <span class="chip">{{ analysis.pages_fetched or 0 }} pagine lette · {{ when(analysis.started_at) }}</span>
      {% set langs = (shown.body.get('languages') if shown else None) or {} %}
      {% if langs|length > 1 %}<span class="chip">Lingue: {% for k, v in langs.items() %}{{ k }} ({{ v }}){{ ', ' if not loop.last }}{% endfor %}</span>
      {% elif site.language %}<span class="chip">Lingua: {{ site.language }}</span>{% endif %}
      <span class="chip">robots.txt rispettato</span>
    </div>
    {% endif %}
  </div>
  {% if caller.can('owner') %}
  <div class="row">
    <form class="inline" method="post" action="/ui/sites/{{ site.id }}/review"><button class="btn" type="submit">Rianalizza ora</button></form>
    {% if shown %}<a class="btn" href="/site?edit=1">Modifica il profilo</a>{% endif %}
  </div>
  {% endif %}
</header>

{{ job_panel() }}

{% if analysis and analysis.problems %}
<div class="dashed"><strong>Cosa non è andato nell'ultima analisi</strong>{% for p in analysis.problems[:6] %}<span class="hint">{{ p }}</span>{% endfor %}</div>
{% endif %}

{% if editing %}
<section class="card pad" aria-labelledby="h-edit">
  <h2 id="h-edit">Modifica il profilo</h2>
  <p class="lead">Le modifiche diventano una nuova versione in bozza: la linea cambia solo quando la approvi.</p>
  {% if error %}<p class="error">{{ error }}</p>{% endif %}
  <form method="post" action="/ui/sites/{{ site.id }}/profile" style="display: flex; flex-direction: column; gap: 12px;">
    <label class="field">Profilo (JSON)<textarea name="body" spellcheck="false">{{ body_json }}</textarea></label>
    <div class="row"><a class="btn" href="/site">Annulla</a><button class="btn pri" type="submit">Salva come bozza</button></div>
  </form>
</section>
{% elif shown %}
<section class="card {% if draft %}drift{% endif %}" aria-labelledby="h-profile">
  <div class="card-head">
    <div style="display: flex; flex-direction: column; gap: 4px;">
      {% if draft and approved %}
      <h2 id="h-profile">Proposta di aggiornamento della linea · versione {{ draft.version }}</h2>
      <span style="font-size: 14px;">{{ 'Dalla rianalisi' if draft.origin == 'reanalysis' else 'Modifica' }} del {{ when(draft.created_at, 'day') }}. L'agente propone, la linea cambia solo se approvi.</span>
      {% elif draft %}
      <h2 id="h-profile">Profilo proposto · versione {{ draft.version }}</h2>
      <span style="font-size: 14px;">Ricostruito dall'analisi del sito: controllalo e approvalo per avviare piano e opportunità.</span>
      {% else %}
      <h2 id="h-profile">Profilo approvato · versione {{ approved.version }}</h2>
      <span class="hint">Approvato da {{ approved.approved_by }} il {{ when(approved.approved_at, 'day') }}</span>
      {% endif %}
    </div>
    {% if draft and caller.can('owner') %}
    <div class="row">
      {% if approved %}<form class="inline" method="post" action="/ui/sites/{{ site.id }}/discard/{{ draft.version }}"><button class="btn" type="submit">Mantieni la v{{ approved.version }}</button></form>{% endif %}
      <a class="btn" href="/site?edit=1">Modifica</a>
      <form class="inline" method="post" action="/ui/sites/{{ site.id }}/approve/{{ draft.version }}"><button class="btn pri" type="submit">Approva la v{{ draft.version }}</button></form>
    </div>
    {% endif %}
  </div>

  {% set b = shown.body %}
  {% set subs = (b.get('subtopics') or [])[:4] %}
  {% set st = b.get('settings') or {} %}
  {% set sty = b.get('style') or {} %}
  {% set incomplete = not (b.get('sector') or {}).get('value') %}
  <div class="pad" style="gap: 10px; border-bottom: 1px solid var(--line);" aria-labelledby="h-what">
    <h3 id="h-what">Cosa approvi</h3>
    {% if b.get('summary') %}<p class="lead" style="margin: 0;">{{ b.get('summary') }}</p>{% endif %}
    {% if incomplete %}
    <p class="error" style="margin: 0;">L'analisi non è completa: settore, pubblico e stile non sono stati determinati (il motivo è in "Non determinato"). Approvando ora l'agente lavora solo con i temi qui sotto: meglio rianalizzare, o completare il profilo con "Modifica".</p>
    {% endif %}
    <p class="hint" style="margin: 0;">Il profilo è la linea editoriale del sito: tutto il resto parte da qui. Approvato, l'agente:</p>
    <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px;">
      <li><strong>cerca le fonti</strong> che scrivono di {% if subs %}{% for x in subs %}{{ x.name }}{{ ', ' if not loop.last }}{% endfor %}{% else %}questi temi{% endif %}: le testate che il sito già cita, ricerche su Hacker News, GitHub, Hugging Face e arXiv con le parole chiave dei temi, e i domini suggeriti dal modello; ognuna è valutata su cosa pubblica davvero prima di essere usata, e la attivi tu in Fonti;</li>
      <li><strong>raccoglie le notizie</strong> ogni ora e tiene quelle vicine ai temi (pertinenza almeno {{ ((st.get('min_relevance', 0.15)) * 100)|round|int }}%){% if st.get('exclude') %}, scartando {{ st.get('exclude')|join(', ') }}{% endif %};</li>
      <li><strong>misura i trend</strong> con due punteggi separati: Hype, quanto se ne parla in giro, e Opportunità, quanto il tema è vicino al sito e quanto non l'avete già coperto;</li>
      <li><strong>propone {{ st.get('proposals_per_day', 3) }} articoli al giorno</strong> nel piano, con le fonti; decidi tu quali scrivere;</li>
      <li><strong>scrive le bozze</strong> in {{ b.get('language') or 'lingua del sito' }}{% if sty.get('tone') %}, tono {{ sty.get('tone') }}{% endif %}{% if sty.get('typical_words') %}, circa {{ sty.get('typical_words') }} parole{% endif %}, con le fonti citate. Nulla si pubblica senza il tuo sì.</li>
    </ul>
    {% if b.get('read_at') %}<p class="hint" style="margin: 0;">{{ site.domain }} porta a {{ b.get('read_at') }}: è stato letto quel sito.</p>{% endif %}
  </div>

  <div class="pad" style="flex-direction: row; flex-wrap: wrap; gap: 32px;">
    <div style="flex: 3 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
      <div style="display: flex; flex-direction: column; gap: 6px;">
        <span class="label-up">Settore</span>
        {% set old_sector = (approved.body.get('sector') or {}).get('value') if (approved and draft) else none %}
        {% set new_sector = (shown.body.get('sector') or {}).get('value') %}
        <div class="row" style="font-size: 16px; gap: 10px;">
          {% if old_sector and old_sector != new_sector %}<span style="text-decoration: line-through; color: var(--muted);">{{ old_sector }}</span><span aria-hidden="true" class="flat">→</span>{% endif %}
          <strong>{{ new_sector or 'Non determinato' }}</strong>
        </div>
      </div>

      <div style="display: flex; flex-direction: column;">
        <span class="label-up" style="padding-bottom: 6px;">Sotto-tematiche · quota misurata sugli articoli letti</span>
        <div class="share head-row"><span>Tema</span><span>{% if draft and approved %}v{{ approved.version }}{% endif %}</span><span>{% if draft and approved %}v{{ draft.version }}{% else %}Quota{% endif %}</span><span>{% if draft and approved %}Andamento{% endif %}</span></div>
        {% for r in rows %}
        <div class="share">
          <span>{{ r.name }}{% if r.fresh %} <span class="chip blue">nuova</span>{% endif %}</span>
          <span class="num">{% if r.old is not none %}{{ (100 * r.old)|round|int }}%{% endif %}</span>
          <span class="num">{{ (100 * r.new)|round|int }}%</span>
          <div class="row" style="flex-wrap: nowrap;">
            <div class="bar" style="flex: 1;"><i class="ink" style="width: {{ (100 * r.new)|round|int }}%"></i></div>
            <span class="{% if r.delta is not none %}{{ 'up' if r.delta > 0 else ('down' if r.delta < 0 else 'flat') }}{% endif %}" style="font-size: 12px; min-width: 28px;">{% if r.delta is not none %}{{ '+' if r.delta > 0 }}{{ r.delta }}{% endif %}</span>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); align-items: start;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <span class="label-up">Pubblico</span>
          <span>{{ (shown.body.get('audience') or {}).get('value') or 'Non determinato' }}</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <span class="label-up">Stile</span>
          {% set style = shown.body.get('style') or {} %}
          <span>{{ style.get('tone') or 'Tono non determinato' }}{% if style.get('formats') %} · {{ style.get('formats')|join(', ') }}{% endif %}</span>
        </div>
      </div>
    </div>

    <aside style="flex: 2 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px;" aria-labelledby="h-ev">
      <h3 id="h-ev">Prove · {{ evidence|length }} pagine del sito</h3>
      <p class="hint">Ogni affermazione del modello è legata a pagine lette. Quelle senza prova vengono scartate.</p>
      <ol class="evlist">
        {% for e in evidence[:6] %}
        <li><a href="{{ e.url }}" rel="noopener noreferrer" target="_blank">{{ e.url|replace('https://', '')|replace('http://', '') }}</a>{% if e.label %}<small>{{ e.label }}</small>{% endif %}</li>
        {% endfor %}
      </ol>
      {% if evidence|length > 6 %}<span class="hint">e altre {{ evidence|length - 6 }}</span>{% endif %}
      {% if shown.body.get('gaps') %}
      <div class="dashed">
        <strong>Non determinato</strong>
        {% for g in shown.body.get('gaps')[:6] %}<span class="hint">{{ g }}</span>{% endfor %}
      </div>
      {% endif %}
    </aside>
  </div>
</section>
{% else %}
<section class="card pad"><h2>Profilo in preparazione</h2><p class="lead">L'analisi del sito non ha ancora prodotto un profilo. Torna tra poco o rianalizza.</p></section>
{% endif %}

{% if profiles %}
<section class="card pad" aria-labelledby="h-ver">
  <h2 id="h-ver">Versioni</h2>
  <div class="scroll">
    <table style="min-width: 560px;">
      <thead><tr><th>Versione</th><th>Origine</th><th>Stato</th><th>Decisione</th></tr></thead>
      <tbody>
      {% for p in profiles %}
      <tr>
        <td class="num">v{{ p.version }}</td>
        <td>{{ {'analysis': 'Prima analisi', 'reanalysis': 'Rianalisi periodica', 'manual': 'Modifica manuale'}.get(p.origin, p.origin) }}</td>
        <td>{% if p.status == 'approved' %}<span class="chip green">Approvata</span>{% elif p.status == 'draft' %}<span class="chip amber">In attesa</span>{% else %}<span class="chip">Ritirata</span>{% endif %}</td>
        <td>{% if p.approved_by %}{{ p.approved_by }} · {{ when(p.approved_at, 'day') }}{% else %}<span class="flat">–</span>{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% endif %}

{% if caller.can('owner') %}
<section class="card pad" aria-labelledby="h-add">
  <h2 id="h-add">Aggiungi un dominio</h2>
  <form method="post" action="/ui/sites" class="form-grid">
    <label class="field">Dominio<input name="domain" placeholder="esempio.it" required></label>
    <div><button class="btn" type="submit">Analizza il sito</button></div>
  </form>
</section>
{% endif %}
{% endblock %}
