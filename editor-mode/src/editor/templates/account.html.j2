<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Abbonamento') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
<div class="shell">
<nav class="nav" aria-label="{{ _('Sezioni') }}">
  <div class="brand"><img class="logo" src="/static/redazia-logo.webp" alt="Redazia" width="111" height="36"><small>{{ _('Abbonamento') }}</small></div>
  {% for r in rooms %}<a href="#t-{{ r.tenant_id }}">{{ r.name }}</a>{% endfor %}
  {% if back %}<a href="/">{{ _('Torna alla redazione') }}</a>{% endif %}
  {% if me.operator %}<a href="/admin">{{ _('Amministrazione') }}</a>{% endif %}
  <span class="grow"></span>
  <div class="who">
    <span>{{ me.email }}</span>
    <form method="post" action="/logout"><button class="link" type="submit">{{ _('Esci') }}</button></form>
  </div>
</nav>
<main class="main">
  <div class="topbar">{% include "_lang.html.j2" %}</div>
  {% if notice %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
  <header class="head">
    <div><span class="kicker">{{ _('Il tuo account') }}</span><h1>{{ _('Abbonamento') }}</h1></div>
  </header>
{% with page="account" %}{% include "_help.html.j2" %}{% endwith %}

  {% for r in rooms %}
  {% set sub = r.subscription %}
  {% set c = r.customer or {} %}
  <section class="card" id="t-{{ r.tenant_id }}" aria-labelledby="h-{{ r.tenant_id }}">
    <div class="card-head">
      <h2 id="h-{{ r.tenant_id }}">{{ r.name }}</h2>
      <div class="row">
        {% if sub %}<span class="chip {{ 'teal' if sub.status == 'trialing' else 'green' if sub.status == 'active' else 'amber' }}">{{ sub.plan_name }} · {{ sub.label }}</span>{% endif %}
        {% if r.active %}<a class="btn sm" href="/newsroom?t={{ r.tenant_id }}">{{ _('Entra') }}</a>{% endif %}
      </div>
    </div>
    <div class="pad">
      {% set back = '' %}{% set me_email = me.email %}{% include "_subscription.html.j2" %}
    </div>
  </section>
  {% else %}
  <p class="empty card">{{ _("Non sei direttore di nessuna redazione: l'abbonamento lo gestisce chi ti ha invitato.") }}</p>
  {% endfor %}
</main>
</div>
</body>
</html>
