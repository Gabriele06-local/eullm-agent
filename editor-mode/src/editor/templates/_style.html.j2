@media (max-width: 820px) {
  .nav { border-right: 0; border-bottom: 1px solid var(--line); flex-direction: row;
         flex-wrap: wrap; align-items: center; padding: 12px 16px; gap: 8px; }
  .nav-burger { display: inline-flex; flex-direction: column; justify-content: center; gap: 4px;
