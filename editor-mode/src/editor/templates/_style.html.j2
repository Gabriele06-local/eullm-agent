code { font: 12px var(--mono); background: var(--bg); padding: 1px 4px; border-radius: 4px; }
/* A checkbox and its label, no script: on a narrow screen the sections fold
   into a hamburger that opens them on tap and closes them on the next tap. */
.nav-toggle { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.nav-burger { display: none; }
