<style>
:root {
  --bg: #F4F5F2; --surface: #FFFFFF; --ink: #16191D; --ink-2: #3B4148; --muted: #5A6169;
  --line: #DDE0DC; --line-2: #ECEEEA; --track: #E9EBE6;
  --accent: #1C47C9; --accent-dark: #12328F; --accent-soft: #E6ECFB;
  --hype: #E8913A; --amber: #9A4A06; --amber-soft: #FDF1E3;
  --green: #1E6B43; --green-soft: #E5F3EA; --red: #A3271B; --red-soft: #FBE9E6; --teal: #1F6466; --teal-soft: #E3F0EF; --grey-soft: #EEF0EC;
  --sans: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --serif: "Source Serif 4", "Source Serif Pro", Georgia, serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--sans); }
a { color: var(--accent); } a:hover { color: var(--accent-dark); }
h1 { margin: 0; font-size: 30px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
h2 { margin: 0; font-size: 17px; font-weight: 600; }
h3 { margin: 0; font-size: 16px; font-weight: 600; }
p { margin: 0; }
.shell { display: flex; flex-wrap: wrap; min-height: 100vh; }
.nav { flex: 1 1 232px; max-width: 100%; padding: 24px 16px; background: var(--surface); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
.nav-body > a { display: flex; align-items: center; padding: 9px 12px; min-height: 40px; border-radius: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; }
.nav-body > a:hover { background: var(--track); color: var(--ink); }
.nav-body > a.on { background: var(--ink); color: #FFFFFF; }
.nav-body > a.plan-link { flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; }
.nav-body > a.plan-link small { font-size: 12px; color: var(--muted); }
.nav-body > a.plan-link.on small { color: #FFFFFF; opacity: 0.75; }
.form-grid.billing { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 760px; align-items: start; }
@media (max-width: 640px) { .form-grid.billing { grid-template-columns: 1fr; } .form-grid.billing .field { grid-column: auto !important; } }
.form-grid.billing .wide { grid-column: 1 / -1; }
.brand { text-decoration: none; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 0 12px 20px; }
.brand .logo { display: block; height: 36px; width: auto; }
.brand small { font-size: 12px; color: var(--muted); padding-left: 2px; }
.switch { display: flex; flex-direction: column; gap: 4px; padding: 0 0 16px; }
.switch label { font-size: 12px; color: var(--muted); padding: 0 12px; }
.grow { flex-grow: 1; min-height: 24px; }
.who .name { overflow-wrap: anywhere; color: var(--ink); }
.who { display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 12px; margin-top: 8px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
.main { flex: 999 1 560px; min-width: 0; padding: 32px clamp(16px, 3vw, 40px) 56px; display: flex; flex-direction: column; gap: 24px; }
.head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
.head > div:first-child { display: flex; flex-direction: column; gap: 6px; }
.kicker { font-size: 13px; color: var(--muted); }
.lead { font-size: 14px; color: var(--muted); }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.cols { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
.col-wide { flex: 3 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
.col-side { flex: 2 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.pad { padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; }
.card-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
.item { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--line-2); }
.item:last-child { border-bottom: 0; }
.item .what { flex: 1 1 260px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.item .what strong { font-weight: 600; }
.item .what span { font-size: 14px; color: var(--muted); }
.prop { margin: 4px 0 0; display: grid; gap: 2px; font-size: 14px; }
.prop dt { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; margin-top: 6px; }
.prop dd { margin: 0; overflow-wrap: anywhere; }
.prop ul { margin: 0; padding-left: 18px; }
.prop li { margin: 2px 0; }
.prop .hint { font-size: 12px; }
.empty { padding: 20px; color: var(--muted); font-size: 14px; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
.stat { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
.stat .label { font-size: 13px; color: var(--muted); }
.stat .value { font: 500 32px/1.1 var(--mono); }
.stat .value small { font-size: 15px; color: var(--muted); }
.stat .note { font-size: 13px; color: var(--muted); }
.stat .note.warn { color: var(--amber); }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; padding: 0 14px; border-radius: 8px; font: 500 14px var(--sans); border: 1px solid #C9CDC7; background: var(--surface); color: var(--ink); cursor: pointer; text-decoration: none; white-space: nowrap; }
.btn:hover { border-color: var(--ink-2); color: var(--ink); }
.btn.pri { background: var(--accent); border-color: var(--accent); color: #FFFFFF; }
.btn.pri:hover { background: var(--accent-dark); border-color: var(--accent-dark); color: #FFFFFF; }
.btn.danger { color: var(--red); border-color: var(--red); }
.btn.danger:hover { background: var(--red-soft); }
details.manage { display: flex; flex-direction: column; gap: 8px; margin: 4px 0 10px; }
details.manage > summary { cursor: pointer; font-size: 13px; color: var(--muted); }
details.manage[open] > summary { margin-bottom: 8px; }
.btn.sm { min-height: 32px; padding: 0 10px; font-size: 13px; }
.btn:focus-visible, a:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.link { background: none; border: 0; padding: 0; font: inherit; font-size: 12px; color: var(--accent); cursor: pointer; text-decoration: underline; }
form.inline { display: inline-flex; }
.chip { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 11px; font: 500 12px var(--sans); white-space: nowrap; background: var(--grey-soft); color: var(--ink-2); }
.chip.blue { background: var(--accent-soft); color: var(--accent); }
.chip.amber { background: var(--amber-soft); color: var(--amber); }
.chip.green { background: var(--green-soft); color: var(--green); }
.chip.red { background: var(--red-soft); color: var(--red); }
.chip.teal { background: var(--teal-soft); color: var(--teal); }
.chip.dark { background: var(--ink); color: #FFFFFF; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
.kpi { padding: 12px 16px; display: flex; flex-direction: column; gap: 2px; color: var(--ink); text-decoration: none; min-width: 0; }
a.kpi:hover { border-color: var(--ink-2); color: var(--ink); }
.kpi .label { font-size: 12px; color: var(--muted); }
.kpi .value { font: 500 24px/1.2 var(--mono); }
.kpi .note { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi.warn .value, .kpi.warn .note { color: var(--amber); }
.kpi.bad { border-color: #E3B3AC; } .kpi.bad .value, .kpi.bad .note { color: var(--red); }
.board { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 16px; align-items: start; }
.stack { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
@media (max-width: 1100px) { .board { grid-template-columns: minmax(0, 1fr); } }
.item.line { flex-wrap: nowrap; gap: 12px; padding: 9px 20px; }
.item.line > .chip { flex: none; max-width: 160px; overflow: hidden; text-overflow: ellipsis; }
.item.line .what { flex: 1 1 auto; gap: 0; }
.item.line .what strong { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item.line .one { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
details.item.line.prop-line { display: block; padding: 0; }
details.prop-line > summary { display: flex; align-items: center; gap: 12px; padding: 9px 20px; cursor: pointer; list-style: none; min-width: 0; }
details.prop-line > summary::-webkit-details-marker { display: none; }
details.prop-line > summary .chip { flex: none; max-width: 160px; overflow: hidden; text-overflow: ellipsis; }
details.prop-line > summary .what { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; }
details.prop-line > summary .what strong { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
details.prop-line > summary .what .one { color: var(--muted); }
details.prop-line > summary .more { flex: none; font-size: 12px; }
details.prop-line[open] > summary .more { visibility: hidden; }
details.prop-line[open] > summary .what strong { white-space: normal; }
details.prop-line .detail { padding: 0 20px 14px; }
.plan-line { align-items: flex-start; scroll-margin-top: 16px; }
.plan-line > .chip { margin-top: 2px; }
.plan-line .plan-what { flex: 1 1 auto; min-width: 0; }
.plan-line .plan-what > summary { display: flex; flex-direction: column; cursor: pointer; list-style: none; min-width: 0; }
.plan-line .plan-what > summary::-webkit-details-marker { display: none; }
.plan-line .plan-what > summary strong { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.plan-line .plan-what[open] > summary strong { white-space: normal; }
.plan-line .plan-what > summary .one { font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.plan-line .plan-what[open] > summary .more { visibility: hidden; }
.plan-line .plan-what .detail { padding-top: 8px; }
.trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.trio > div { display: flex; flex-direction: column; }
.trio .num { font-size: 20px; }
.trio small { font-size: 12px; color: var(--muted); }
.trio-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; align-items: start; }
.rank { gap: 10px; }
.rank-row { display: grid; grid-template-columns: minmax(90px, 1.2fr) minmax(60px, 1fr) auto; gap: 10px; align-items: center; font-size: 13px; }
.rank-row a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-row .num { font-size: 12px; color: var(--muted); white-space: nowrap; }
.news-row { display: flex; flex-direction: column; gap: 1px; font-size: 13px; padding-bottom: 8px; border-bottom: 1px solid var(--line-2); }
.news-row:last-child { border-bottom: 0; padding-bottom: 0; }
.news-row a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--ink); text-decoration: none; }
.news-row a:hover { color: var(--accent); text-decoration: underline; }
.news-row small { font-size: 12px; color: var(--muted); }
table.sites { min-width: 1040px; }
.rank-item { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 14px; padding: 14px 20px; border-bottom: 1px solid var(--line-2); align-items: start; }
.rank-item:last-child { border-bottom: 0; }
.rank-item .pos { font-size: 18px; color: var(--muted); text-align: right; padding-top: 1px; }
.rank-item .body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.rank-item .body p { font-size: 14px; color: var(--ink-2); }
.rank-item .body ul { margin: 2px 0 0; padding-left: 18px; font-size: 13px; }
.rank-item .body li { margin: 1px 0; overflow-wrap: anywhere; }
.rank-item .side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
@media (max-width: 720px) { .rank-item { grid-template-columns: 28px minmax(0, 1fr); } .rank-item .side { grid-column: 2; align-items: flex-start; } }
table.sites td { padding: 9px 10px; }
.activity { margin-bottom: 20px; }
.activity.compact { margin-bottom: 0; }
.activity.compact .item { flex-wrap: nowrap; gap: 12px; padding: 9px 20px; }
.activity.compact .item > .chip { flex: none; }
.activity.compact .what { flex: 1 1 auto; gap: 0; }
.activity.compact .what strong { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.activity.compact .one { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
.activity.compact .when { flex: none; font-size: 12px; color: var(--muted); white-space: nowrap; }
@media (max-width: 640px) { .activity.compact .when { display: none; } }
.activity .note.warn, .what .note.warn { color: var(--amber); font-size: 14px; }
.spin { width: 10px; height: 10px; margin-right: 6px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spin .9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
.num { font-family: var(--mono); }
.bar { height: 8px; border-radius: 4px; background: var(--track); overflow: hidden; }
.bar > i { display: block; height: 100%; border-radius: 4px; background: var(--accent); }
.bar > i.hype { background: var(--hype); }
.bar > i.ink { background: var(--ink-2); }
.bar.thin { height: 6px; }
.pair { display: grid; grid-template-columns: 1fr 40px; gap: 4px 8px; align-items: center; font-size: 12px; }
.legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 12px; color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 10px; height: 10px; border-radius: 2px; background: var(--accent); display: inline-block; }
.legend i.hype { background: var(--hype); }
.notice { background: var(--accent-soft); color: var(--accent-dark); border-radius: 10px; padding: 12px 16px; font-size: 14px; }
.error { background: var(--red-soft); color: var(--red); border-radius: 10px; padding: 12px 16px; font-size: 14px; }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; }
.tabs a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px; border-radius: 18px; border: 1px solid #C9CDC7; background: var(--surface); font: 500 13px var(--sans); color: var(--ink-2); text-decoration: none; }
.tabs a.on { background: var(--ink); border-color: var(--ink); color: #FFFFFF; }
.scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { padding: 10px; font-weight: 500; font-size: 12px; color: var(--muted); text-align: left; white-space: nowrap; }
td { padding: 12px 10px; border-top: 1px solid var(--line-2); vertical-align: middle; }
td small { display: block; font-size: 12px; color: var(--muted); }
tr.off { background: #FCF6F5; }
.field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--muted); }
.field input, .field select, .switch select, .field textarea { min-height: 40px; padding: 0 10px; border: 1px solid #C9CDC7; border-radius: 8px; font: 400 14px var(--sans); color: var(--ink); background: var(--surface); }
td select { min-height: 32px; padding: 0 8px; border: 1px solid #C9CDC7; border-radius: 8px; font: 400 13px var(--sans); color: var(--ink); background: var(--surface); }
.field textarea { padding: 10px; font: 13px/1.5 var(--mono); min-height: 360px; }
form.row input[type=number], form.row select { min-height: 36px; padding: 0 10px; border: 1px solid #C9CDC7; border-radius: 8px; font: 400 14px var(--sans); color: var(--ink); background: var(--surface); }
.target-form { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
.target-form .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px 16px; align-items: start; }
.target-form .field, .target-form .check { white-space: nowrap; }
.target-form .field input, .target-form .field select { width: 100%; min-width: 0; }
.check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink); }
.target-form .only-wordpress, .target-form .only-github { display: none; }
.target-form:has(select[name=kind] option[value=wordpress]:checked) .only-wordpress,
.target-form:has(select[name=kind] option[value=github]:checked) .only-github { display: grid; }
.target-form:has(select[name=kind] option[value=wordpress]:checked) label.only-wordpress,
.target-form:has(select[name=kind] option[value=github]:checked) label.only-github { display: flex; }
.field textarea[rows] { min-height: 0; font: 400 14px/1.5 var(--sans); }
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; align-items: end; }
.label-up { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.hint { font-size: 13px; color: var(--muted); }
.dashed { padding: 12px; border: 1px dashed #C9CDC7; border-radius: 8px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
.evlist { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
.evlist li { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; background: var(--bg); border-radius: 8px; overflow-wrap: anywhere; }
.evlist li small { font-size: 12px; color: var(--muted); }
.drift { border-color: #E8C9A5; overflow: hidden; }
.drift .card-head { background: var(--amber-soft); border-color: #E8C9A5; }
.drift .card-head h2, .drift .card-head span { color: #6E3504; }
.share { display: grid; grid-template-columns: minmax(140px, 1.4fr) 64px 64px minmax(120px, 2fr); gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line-2); font-size: 14px; }
.share.head-row { color: var(--muted); font-size: 12px; padding: 6px 0; }
.up { color: var(--green); } .down { color: var(--red); } .flat { color: var(--muted); }
.map { position: relative; height: 420px; margin: 8px 0 28px 28px; border-left: 1px solid #C9CDC7; border-bottom: 1px solid #C9CDC7; }
.map .mid-x { position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px dashed var(--line); }
.map .mid-y { position: absolute; top: 50%; left: 0; right: 0; border-top: 1px dashed var(--line); }
.map .q { position: absolute; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.map .dot { position: absolute; transform: translate(-6px, 6px); display: flex; align-items: center; gap: 6px; font-size: 12px; white-space: nowrap; max-width: 40%; }
.map .dot span { overflow: hidden; text-overflow: ellipsis; }
.map .dot i { flex: none; display: block; width: 12px; height: 12px; border-radius: 6px; background: var(--accent); border: 2px solid #FFFFFF; box-shadow: 0 0 0 1px var(--accent); }
.map .dot.far i { background: var(--hype); box-shadow: 0 0 0 1px var(--hype); }
.map .axis-x { position: absolute; left: 50%; bottom: -26px; transform: translateX(-50%); font-size: 12px; color: var(--muted); }
.map .axis-y { position: absolute; left: -26px; top: 50%; transform: translate(-50%, -50%) rotate(-90deg); font-size: 12px; color: var(--muted); white-space: nowrap; }
.article { padding: clamp(20px, 4vw, 48px); display: flex; flex-direction: column; gap: 18px; font-family: var(--serif); }
.article h1 { font-size: 34px; }
.article .sub { font-size: 19px; color: var(--ink-2); }
.article h2 { font-family: var(--serif); font-size: 22px; margin-top: 8px; }
.article p { font-size: 18px; line-height: 1.7; }
.article sup a { font: 500 11px var(--mono); text-decoration: none; margin-left: 2px; }
.article .flagged { background: var(--red-soft); border-radius: 3px; }
.srclist { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
.srclist li { padding: 10px 12px; border-radius: 8px; border: 1px solid var(--line); display: flex; gap: 10px; }
.srclist li:target { border-color: var(--accent); background: #EEF2FC; }
.srclist .n { font: 12px var(--mono); color: var(--accent); padding-top: 2px; }
.srclist div { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
.checks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
.checks li { display: flex; gap: 10px; align-items: baseline; }
.meter { display: grid; grid-template-columns: minmax(120px, 1fr) minmax(120px, 2fr) 110px; gap: 12px; align-items: center; font-size: 14px; padding: 8px 0; }
.list-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line-2); font-size: 14px; flex-wrap: wrap; }
.list-row:last-child { border-bottom: 0; }
.token { font: 13px var(--mono); background: var(--bg); padding: 10px 12px; border-radius: 8px; overflow-wrap: anywhere; user-select: all; }
.solo { max-width: 420px; margin: 12vh auto; padding: 0 16px; display: flex; flex-direction: column; gap: 16px; }
.solo .brand { padding: 0; }
.lang-pick { flex-direction: row; align-items: center; padding: 8px 10px 4px; }
.lang-pick select { min-height: 30px; padding: 0 6px; font-size: 12px; color: var(--muted); }
.solo .lang-pick { position: fixed; top: 16px; right: 16px; padding: 0; }
.topbar { display: flex; justify-content: flex-end; margin: -16px 0 -12px; }
.topbar .lang-pick { padding: 0; }
.help { padding: 0; }
.help summary { cursor: pointer; padding: 14px 20px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 14px; }
.help-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; padding: 0 20px 18px; border-top: 1px solid var(--line); padding-top: 14px; }
.help-cols h3 { font-size: 13px; margin: 0 0 4px; color: var(--muted); font-weight: 600; }
