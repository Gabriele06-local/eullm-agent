<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Invito') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="Redazia" width="111" height="36"></div>
  <section class="card pad">
  {% if not info %}
    <h1 style="font-size: 22px;">{{ _('Link non valido') }}</h1>
    <p class="lead">{{ _("Il link è scaduto o è già stato usato. Chiedine uno nuovo a chi te l'ha mandato.") }}</p>
    <a class="btn" href="/login">{{ _("Vai all'accesso") }}</a>
  {% else %}
    {% if info.kind == 'reset' %}
    <h1 style="font-size: 22px;">{{ _('Nuova password') }}</h1>
    <p class="lead">{{ _('Scegli la nuova password di {email}.', email=info.email) }}</p>
    {% else %}
    <h1 style="font-size: 22px;">{% if info.newsroom %}{{ _('Entra in {newsroom}', newsroom=info.newsroom) }}{% else %}{{ _('Console del servizio') }}{% endif %}</h1>
    <p class="lead">{% if info.role and info.operator %}{{ _('{who} ha invitato {email} come {role} come amministratore del servizio.', who=info.created_by, email=info.email, role={'owner': _('direttore'), 'editor': _('redattore'), 'viewer': _('lettura')}[info.role]) }}{% elif info.role %}{{ _('{who} ha invitato {email} come {role}.', who=info.created_by, email=info.email, role={'owner': _('direttore'), 'editor': _('redattore'), 'viewer': _('lettura')}[info.role]) }}{% elif info.operator %}{{ _('{who} ha invitato {email} come amministratore del servizio.', who=info.created_by, email=info.email) }}{% else %}{{ _('{who} ha invitato {email}.', who=info.created_by, email=info.email) }}{% endif %}</p>
    {% endif %}
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/invite/{{ token }}" style="display: flex; flex-direction: column; gap: 12px;">
      <input type="hidden" name="email" value="{{ info.email }}" autocomplete="username">
      {% if info.kind == 'invite' and info.has_password %}
      <label class="field">{{ _('La password del tuo account') }}<input name="password" type="password" autocomplete="current-password" required autofocus></label>
      <button class="btn pri" type="submit">{{ _("Accetta l'invito") }}</button>
      {% else %}
      {% if info.kind == 'invite' %}<label class="field">{{ _('Nome') }}<input name="name" autocomplete="name" value="{{ info.user_name }}" maxlength="100"></label>{% endif %}
      <label class="field">{{ _('Password (almeno {min} caratteri)', min=min) }}<input name="password" type="password" autocomplete="new-password" minlength="{{ min }}" required autofocus></label>
      <label class="field">{{ _('Ripeti la password') }}<input name="again" type="password" autocomplete="new-password" minlength="{{ min }}" required></label>
      <button class="btn pri" type="submit">{% if info.kind == 'reset' %}{{ _('Salva ed entra') }}{% else %}{{ _("Crea l'account ed entra") }}{% endif %}</button>
      {% endif %}
    </form>
  {% endif %}
  </section>
  {% include "_lang.html.j2" %}
</main>
</body>
</html>
