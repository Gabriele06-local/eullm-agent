<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ status }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="Redazia" width="111" height="36"></div>
  <section class="card pad">
    <span class="kicker num">{{ _('Errore {status}', status=status) }}</span>
    <h1 style="font-size: 22px;">{{ {403: _('Non hai il permesso per questa azione'), 404: _('Non trovato'), 429: _('Limite del piano raggiunto')}.get(status, _('Qualcosa non è andato')) }}</h1>
    {% if detail %}<p class="lead">{{ detail }}</p>{% endif %}
    <div class="row"><a class="btn pri" href="/">{{ _('Torna al Desk') }}</a></div>
  </section>
  {% include "_lang.html.j2" %}
</main>
</body>
</html>
