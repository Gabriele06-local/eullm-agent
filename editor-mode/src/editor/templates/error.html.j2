<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ status }} · EuLLM Editor</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="EuLLM" width="130" height="36"><small>Editor Mode</small></div>
  <section class="card pad">
    <span class="kicker num">Errore {{ status }}</span>
    <h1 style="font-size: 22px;">{{ {403: 'Non hai il permesso per questa azione', 404: 'Non trovato', 429: 'Limite del piano raggiunto'}.get(status, 'Qualcosa non è andato') }}</h1>
    {% if detail %}<p class="lead">{{ detail }}</p>{% endif %}
    <div class="row"><a class="btn pri" href="/">Torna a Oggi</a></div>
  </section>
</main>
</body>
</html>
