<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Prima configurazione') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/redazia-logo.webp" alt="Redazia" width="111" height="36"></div>
  <section class="card pad">
  {% if not valid %}
    <h1 style="font-size: 22px;">{{ _('Link non valido') }}</h1>
    <p class="lead">{{ _("Il link è scaduto, è già stato usato o l'amministratore esiste già. Per un link nuovo, sul server: <code>docker compose exec editor-web editor setup-link</code>.") }}</p>
    <a class="btn" href="/login">{{ _("Vai all'accesso") }}</a>
  {% else %}
    <h1 style="font-size: 22px;">{{ _("Crea l'amministratore") }}</h1>
    <p class="lead">{{ _("È l'account di chi gestisce il servizio: crea le redazioni, ne imposta piani e limiti e invita i loro responsabili.") }}</p>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/setup/{{ token }}" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">{{ _('Nome') }}<input name="name" autocomplete="name" maxlength="100"></label>
      <label class="field">{{ _('Email') }}<input name="email" type="email" autocomplete="username" required autofocus></label>
      <label class="field">{{ _('Password (almeno {min} caratteri)', min=min) }}<input name="password" type="password" autocomplete="new-password" minlength="{{ min }}" required></label>
      <label class="field">{{ _('Ripeti la password') }}<input name="again" type="password" autocomplete="new-password" minlength="{{ min }}" required></label>
      <button class="btn pri" type="submit">{{ _('Crea ed entra') }}</button>
    </form>
  {% endif %}
  </section>
  {% include "_lang.html.j2" %}
</main>
</body>
</html>
