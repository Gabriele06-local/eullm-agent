<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Amministrazione') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
{% set labels = {'sites': _('Siti'), 'sources': _('Fonti attive'), 'items': _('Notizie oggi'), 'drafts': _('Bozze nel mese'), 'llm_cost': _('Costo modello nel mese')} %}
<div class="shell">
<nav class="nav" aria-label="{{ _('Sezioni') }}">
  <a class="brand" href="/admin">``&lt;img class="logo" src="/static/redazia-logo.webp" alt="Redazia" width="111" height="36"&gt;``<small>{{ _('Amministrazione') }}</small></a>
<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="{{ _('Sezioni') }}">
<label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span><span></span><span></span></label>
<div class="nav-body">
  <a href="#redazioni" class="on">{{ _('Redazioni') }}</a>
  <a href="#nuova">{{ _('Nuova redazione') }}</a>
  <a href="#clienti">{{ _('Clienti') }}</a>
  <a href="#rivenditori">{{ _('Rivenditori') }}</a>
  <a href="#piani">{{ _('Piani') }}</a>
  <a href="#operatori">{{ _('Amministratori') }}</a>
  <a href="#api">{{ _('Chiavi API') }}</a>
  <a href="#aggiornamenti">{{ _('Aggiornamenti') }}{% if updates.newer %} <span class="chip teal">{{ updates.available.version }}</span>{% endif %}</a>
  <a href="/admin/usage">{{ _('Consumi') }}</a>
  {% if mine %}<span class="hint" style="padding: 12px 12px 4px;">{{ _('Le tue redazioni') }}</span>
  {% for x in mine %}<a href="/admin/enter/{{ x.tenant_id }}">{{ x.name }}</a>{% endfor %}{% endif %}
  <span class="grow"></span>
  {% if updates.installed %}<small class="hint" style="font-size: 11px; padding: 0 10px;"><a href="#aggiornamenti">Redazia {{ updates.installed }}</a></small>{% endif %}
  <div class="who">
    <span class="name" title="{{ me.email }}">{{ me.email }}</span>
    <div class="row" style="justify-content: space-between; align-items: center;">
      <span>{{ _('amministratore') }}</span>
      <form method="post" action="/logout"><button class="link" type="submit">{{ _('Esci') }}</button></form>
    </div>
  </div>
</div>
</nav>
<main class="main">
  <div class="topbar">{% include "_lang.html.j2" %}</div>
  {% if notice and not notice_at %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  {% if updates.newer and not updates.pending %}<p class="notice" role="status" style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;"><span>{{ _('È disponibile la versione {version} (installata: {installed}).', version=updates.available.version, installed=updates.installed) }}</span><a href="#aggiornamenti">{{ _('Aggiorna') }}</a></p>{% endif %}
  {% if new %}
  <section class="card pad" style="border-color: var(--accent);" aria-labelledby="h-new">
    <h2 id="h-new">{{ new.what }}</h2>
    {% if new.link %}
      {% if new.link.sent %}<p class="lead">{{ _('Il link è partito per email a {email}.', email=new.link.email) }}</p>
      {% else %}<p class="lead">{{ _('Questo server non manda email: manda tu questo link a {email}. Si usa una volta.', email=new.link.email) }}</p>
      <div class="token">{{ new.link.url }}</div>{% endif %}
    {% endif %}
    {% if new.key %}<p class="lead">{{ _("Copiala adesso: non verrà più mostrata. Va nell'intestazione <code>Authorization: Bearer …</code> delle chiamate a <code>/api/operator/</code>.") }}</p><div class="token">{{ new.key }}</div>{% endif %}
    {% if new.note %}<p class="lead">{{ new.note }}</p>{% endif %}
    {% if new.warning %}<p class="error">{{ new.warning }}</p>{% endif %}
  </section>
  {% endif %}

  <header class="head" id="redazioni">
    <div><span class="kicker">{{ _('Amministrazione') }}</span><h1>{{ _('Redazioni') }}</h1></div>
    <span class="chip dark">{{ rooms|length }} {{ _('redazione') if rooms|length == 1 else _('redazioni') }}</span>
  </header>
{% with page="console" %}{% include "_help.html.j2" %}{% endwith %}

  {% for r in rooms %}
  <section class="card" aria-labelledby="h-{{ r.tenant_id }}">
    <div class="card-head">
      <div style="display: flex; flex-direction: column; gap: 2px;">
        <h2 id="h-{{ r.tenant_id }}">{{ r.name }}</h2>
        <span class="hint"><span class="num">{{ r.tenant_id }}</span> · {{ _('piano {plan}', plan=r.plan or '–') }} · {{ r.members }} {{ _('persona') if r.members == 1 else _('persone') }}{% if r.external_ref %} · {{ _('rif.') }} <span class="num">{{ r.external_ref }}</span>{% endif %} · {{ _('dal {date}', date=r.created_at.strftime('%d/%m/%Y') if r.created_at else '–') }}</span>
      </div>
      <div class="row">
        {% set sub = subs.get(r.tenant_id) %}
        {% if sub %}<span class="chip {{ 'teal' if sub.status == 'trialing' else 'green' if sub.status == 'active' else 'amber' }}">{{ sub.plan_name }} · {{ sub.label }}{% if sub.days_left is not none and sub.status != 'expired' %} · {{ _('{n} gg', n=sub.days_left) }}{% endif %}</span>{% endif %}
        {% if r.hold == 'billing' %}<span class="chip amber">{{ _('Ferma: piano da pagare') }}</span>{% elif r.active is sameas false %}<span class="chip red">{{ _('Sospesa') }}</span>{% else %}<span class="chip green">{{ _('Attiva') }}</span>{% endif %}
        <a class="btn sm" href="/admin/enter/{{ r.tenant_id }}">{{ _('Entra') }}</a>
        <form class="inline" method="post" action="/admin/newsrooms/{{ r.tenant_id }}/active">
          <input type="hidden" name="active" value="{{ '1' if r.active is sameas false else '0' }}">
          <button class="btn sm" type="submit">{{ _('Riattiva') if r.active is sameas false else _('Sospendi') }}</button>
        </form>
      </div>
    </div>
    <div class="pad">
      {% for what, u in r.usage.items() %}
      {% set pct = (100 * (u.used or 0) / u.limit)|round|int if u.limit else 0 %}
      <div class="meter">
        <span>{{ labels[what] }}</span>
        {% if u.limit %}<div class="bar" role="img" aria-label="{{ pct }}%"><i {% if pct >= 90 %}class="hype"{% endif %} style="width: {{ [pct, 100]|min }}%"></i></div>
        {% else %}<span class="hint">{{ _('senza limite') }}</span>{% endif %}
        <span class="num" style="text-align: right;">{% if what == 'llm_cost' %}€ {{ (u.used or 0)|num }}{% if u.limit is not none %} / {{ u.limit|num(0) }}{% endif %}{% else %}{{ (u.used or 0)|int }}{% if u.limit is not none %} / {{ u.limit|int }}{% endif %}{% endif %}</span>
      </div>
      {% endfor %}
      <details>
        <summary class="hint">{{ _('Abbonamento') }}{% if sub %}: {{ sub.plan_name }}, {{ sub.label|lower }}{% if sub.current_period_end %}, {{ _('pagato fino al {date}', date=sub.current_period_end.strftime('%d/%m/%Y')) }}{% elif sub.trial_ends_at %}, {{ _('prova fino al {date}', date=sub.trial_ends_at.strftime('%d/%m/%Y')) }}{% endif %}{% if sub.provider == 'mollie' %} (Mollie){% elif sub.provider == 'reseller' %} ({{ _('rivenditore') }}){% endif %}{% endif %}</summary>
        <form method="post" action="/admin/subscriptions/{{ r.tenant_id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Piano') }}<select name="plan">{% for p in plans %}<option value="{{ p.code }}" {% if sub and sub.plan_code == p.code %}selected{% endif %}>{{ p.name }}</option>{% endfor %}</select></label>
          <label class="field">{{ _('Rinnovo') }}<select name="interval"><option value="month">{{ _('Mensile') }}</option><option value="year" {% if sub and sub.billing_interval == 'year' %}selected{% endif %}>{{ _('Annuale') }}</option></select></label>
          <label class="field">{{ _('Pagato fino al') }}<input name="paid_until" type="date"></label>
          <label class="field">{{ _('Importo ricevuto (€)') }}<input name="amount" inputmode="decimal" placeholder="{{ _('nessuno') }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        <p class="hint">{{ _('Con un importo registra un pagamento ricevuto (bonifico) e, senza data, allunga di un mese o un anno. Senza importo cambia solo il piano; senza data il piano non scade. I limiti del piano sostituiscono quelli della redazione.') }}</p>
      </details>
      <details>
        <summary class="hint">{{ _('Nome, piano e limiti') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Nome') }}<input name="name" value="{{ r.name }}" maxlength="100" required></label>
          <label class="field">{{ _('Piano') }}<input name="plan" value="{{ r.plan or '' }}" maxlength="60"></label>
          <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" value="{{ r.max_sites if r.max_sites is not none else '' }}"></label>
          <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" value="{{ r.max_active_sources if r.max_active_sources is not none else '' }}"></label>
          <label class="field">{{ _('Notizie al giorno') }}<input name="max_items_per_day" inputmode="numeric" value="{{ r.max_items_per_day if r.max_items_per_day is not none else '' }}"></label>
          <label class="field">{{ _('Bozze al mese') }}<input name="max_drafts_month" inputmode="numeric" value="{{ r.max_drafts_month if r.max_drafts_month is not none else '' }}"></label>
          <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" value="{{ r.max_languages if r.max_languages is not none else '' }}"></label>
          <label class="field">{{ _('Costo modello al mese (€)') }}<input name="max_llm_cost_month" inputmode="decimal" value="{{ (r.max_llm_cost_month|string)|replace('.', ',') if r.max_llm_cost_month is not none else '' }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        <p class="hint">{{ _('Vuoto vuol dire senza limite. Il costo del modello diventa anche il limite della redazione nel Core.') }}</p>
      </details>
      <details>
        <summary class="hint">{{ _('Invita una persona') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/invite" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
          <label class="field">{{ _('Ruolo') }}<select name="role"><option value="owner" selected>{{ _('Direttore') }}</option><option value="editor">{{ _('Redattore') }}</option><option value="viewer">{{ _('Lettura') }}</option></select></label>
          <div><button class="btn" type="submit">{{ _("Crea l'invito") }}</button></div>
        </form>
      </details>
      <details>
        <summary class="hint">{{ _('Cancella la redazione') }}</summary>
        <form method="post" action="/admin/newsrooms/{{ r.tenant_id }}/delete" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Scrivi <span class="num">{id}</span> per confermare', id=r.tenant_id) }}<input name="confirm" autocomplete="off" required></label>
          <div><button class="btn" type="submit">{{ _('Cancella tutto') }}</button></div>
        </form>
        <p class="hint">{{ _('Cancella siti, profili, fonti, articoli, bozze, pubblicazioni e persone della redazione. Non si torna indietro: prima scarica i dati da Impostazioni della redazione.') }}</p>
      </details>
    </div>
  </section>
  {% else %}
  <p class="empty card">{{ _("Nessuna redazione: creane una qui sotto, oppure lasciala creare al sistema di pagamento con l'API.") }}</p>
  {% endfor %}

  <section class="card pad" id="nuova" aria-labelledby="h-create">
    <h2 id="h-create">{{ _('Nuova redazione') }}</h2>
    <p class="hint">{{ _('Il direttore riceve un invito per scegliere la sua password (o se ha già un account la trova fra le sue redazioni).') }}</p>
    <form method="post" action="/admin/newsrooms" class="form-grid">
      <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100" placeholder="{{ _('Redazione i3k') }}"></label>
      <label class="field">{{ _('Email del direttore') }}<input name="owner_email" type="email" required></label>
      <label class="field">{{ _('Piano') }}<input name="plan" maxlength="60" placeholder="standard"></label>
      <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" placeholder="{{ _('senza limite') }}"></label>
      <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" placeholder="{{ _('senza limite') }}"></label>
      <label class="field">{{ _('Notizie al giorno') }}<input name="max_items_per_day" inputmode="numeric" placeholder="{{ _('senza limite') }}"></label>
      <label class="field">{{ _('Bozze al mese') }}<input name="max_drafts_month" inputmode="numeric" placeholder="{{ _('senza limite') }}"></label>
      <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" placeholder="{{ _('senza limite') }}"></label>
      <label class="field">{{ _('Costo modello al mese (€)') }}<input name="max_llm_cost_month" inputmode="decimal" placeholder="{{ _('senza limite') }}"></label>
      <div><button class="btn pri" type="submit">{{ _('Crea la redazione') }}</button></div>
    </form>
  </section>

  <section class="card" id="clienti" aria-labelledby="h-customers">
    <div class="card-head"><h2 id="h-customers">{{ _('Clienti') }}</h2><span class="hint">{{ customers|length }}</span></div>
    {% if customers %}
    <div class="pad" style="overflow-x: auto;">
    <table class="tbl">
      <thead><tr><th>{{ _('Cliente') }}</th><th>{{ _('Fiscale') }}</th><th>{{ _('Indirizzo') }}</th><th>{{ _('Redazioni') }}</th><th>{{ _('Rivenditore') }}</th></tr></thead>
      <tbody>
      {% for c in customers %}
      <tr>
        <td><strong>{{ c.name }}</strong><br><span class="hint">{{ c.email }}{% if c.phone %} · {{ c.phone }}{% endif %}</span>{% if c.external_ref %}<br><span class="hint">{{ _('rif.') }} <span class="num">{{ c.external_ref }}</span></span>{% endif %}</td>
        <td class="hint">{% if c.vat_number %}{{ _('P.IVA') }} {{ c.vat_number }}<br>{% endif %}{% if c.tax_code %}{{ _('CF') }} {{ c.tax_code }}<br>{% endif %}{% if c.sdi_code %}SDI {{ c.sdi_code }}<br>{% endif %}{% if c.pec %}PEC {{ c.pec }}{% endif %}</td>
        <td class="hint">{{ c.address }}{% if c.city %}<br>{{ c.postal_code }} {{ c.city }}{% if c.province %} ({{ c.province }}){% endif %}{% endif %}<br>{{ c.country }}</td>
        <td>{% for n in c.newsrooms %}<div>{{ n.name }} <span class="hint">{{ n.plan_code or '–' }} · {{ _(statuses[n.status]) if n.status in statuses else '–' }}</span></div>{% else %}<span class="hint">{{ _('nessuna') }}</span>{% endfor %}</td>
        <td class="hint">{{ reseller_names.get(c.reseller_id) or _('diretto') }}</td>
      </tr>
      <tr><td colspan="5">
        <details>
          <summary class="hint">{{ _('Modifica o elimina {name}', name=c.name) }}</summary>
          <form method="post" action="/admin/customers/{{ c.id }}" class="form-grid" style="margin-top: 8px;">
            <label class="field">{{ _('Tipo') }}<select name="kind"><option value="company">{{ _('Azienda o professionista') }}</option><option value="person" {% if c.kind == 'person' %}selected{% endif %}>{{ _('Privato') }}</option></select></label>
            {% for f, label in [('name', _('Nome o ragione sociale')), ('email', _('Email')), ('phone', _('Telefono')), ('vat_number', _('P.IVA')), ('tax_code', _('Codice fiscale')), ('address', _('Indirizzo')), ('postal_code', _('CAP')), ('city', _('Città')), ('province', _('Provincia')), ('country', _('Paese')), ('sdi_code', _('Codice SDI')), ('pec', 'PEC')] %}
            <label class="field">{{ label }}<input name="{{ f }}" value="{{ c[f] or '' }}"{% if f in ('name', 'email') %} required{% endif %}></label>
            {% endfor %}
            <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
          </form>
          {% if not c.newsrooms %}
          <form method="post" action="/admin/customers/{{ c.id }}/delete" onsubmit='return confirm({{ _('Eliminare il cliente {name}?', name=c.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il cliente') }}</button></form>
          {% else %}
          <p class="hint">{{ _('Si può eliminare quando non ha più redazioni.') }}</p>
          {% endif %}
        </details>
      </td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <p class="empty">{{ _('Nessun cliente: arrivano dal sito con <code>POST /api/operator/signup</code>, o dai rivenditori.') }}</p>
    {% endif %}
    <div class="pad" id="prove-negate">
      <h3>{{ _('Seconde prove negate') }}</h3>
      <p class="hint">{{ _('La prova gratuita si dà una volta sola: chi torna con la stessa email, P.IVA, codice fiscale o telefono, o con un sito già provato in un\'altra redazione, ha la redazione ferma finché non sceglie un piano. Se è un errore, ridai la prova dalla redazione, in Abbonamento.') }}</p>
      {% if refusals %}
      <table class="tbl">
        <thead><tr><th>{{ _('Quando') }}</th><th>{{ _('Redazione') }}</th><th>{{ _('Cliente') }}</th><th>{{ _('Già usato') }}</th></tr></thead>
        <tbody>
        {% for r in refusals %}
        <tr>
          <td class="hint num">{{ r.created_at.strftime('%d/%m/%Y %H:%M') if r.created_at.strftime is defined else r.created_at }}</td>
          <td>{{ r.newsroom }}</td>
          <td>{% if r.name %}{{ r.name }}<br><span class="hint">{{ r.email }}</span>{% else %}<span class="hint">–</span>{% endif %}</td>
          <td class="hint">{% for x in r.reasons %}<div>{{ _(trial_kinds[x.kind]) }} {{ x.value }}{% if x.newsroom %} ({{ x.newsroom }}){% endif %}</div>{% endfor %}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">{{ _('Nessuna: finora ogni prova è andata a chi non l\'aveva mai avuta.') }}</p>
      {% endif %}
    </div>
  </section>

  <div class="cols">
    <section class="card pad col-wide" id="rivenditori" aria-labelledby="h-resellers">
      <h2 id="h-resellers">{{ _('Rivenditori') }}</h2>
      <p class="hint">{{ _('Un rivenditore iscrive e gestisce i suoi clienti con la sua chiave API e li fattura lui: vede solo i suoi.') }}</p>
      {% for x in resellers %}
      <div class="list-row">
        <span>{{ x.name }} <span class="hint">{{ x.email }} · {{ x.customers }} {{ _('cliente') if x.customers == 1 else _('clienti') }}{% if x.discount_pct %} · {{ _('sconto {pct}%', pct=x.discount_pct|num(0)) }}{% endif %}</span></span>
        <span class="row">
          {% if x.active %}<form class="inline" method="post" action="/admin/resellers/{{ x.id }}/key"><button class="btn sm" type="submit">{{ _('Nuova chiave') }}</button></form>{% else %}<span class="chip">{{ _('Disattivato') }}</span>{% endif %}
          <form class="inline" method="post" action="/admin/resellers/{{ x.id }}/active"><input type="hidden" name="active" value="{{ '0' if x.active else '1' }}"><button class="btn sm" type="submit">{{ _('Disattiva') if x.active else _('Riattiva') }}</button></form>
        </span>
      </div>
      <details>
        <summary class="hint">{{ _('Modifica o elimina {name}', name=x.name) }}</summary>
        <form method="post" action="/admin/resellers/{{ x.id }}" class="form-grid" style="margin-top: 8px;">
          <label class="field">{{ _('Nome') }}<input name="name" value="{{ x.name }}" required maxlength="100"></label>
          <label class="field">{{ _('Email') }}<input name="email" type="email" value="{{ x.email }}" required></label>
          <label class="field">{{ _('Sconto (%)') }}<input name="discount" inputmode="decimal" value="{{ x.discount_pct|num(0) if x.discount_pct else '0' }}"></label>
          <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
        </form>
        {% if not x.customers %}
        <form method="post" action="/admin/resellers/{{ x.id }}/delete" onsubmit='return confirm({{ _('Eliminare {name} e le sue chiavi API?', name=x.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il rivenditore') }}</button></form>
        {% else %}
        <p class="hint">{{ _('Ha dei clienti: si può solo disattivare.') }}</p>
        {% endif %}
      </details>
      {% endfor %}
      <form method="post" action="/admin/resellers" class="form-grid">
        <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100"></label>
        <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
        <label class="field">{{ _('Sconto (%)') }}<input name="discount" inputmode="decimal" value="0"></label>
        <div><button class="btn" type="submit">{{ _('Aggiungi rivenditore') }}</button></div>
      </form>
    </section>
    <section class="card pad col-side" aria-labelledby="h-pay">
      <h2 id="h-pay">{{ _('Pagamenti') }}</h2>
      {% if online %}<p class="lead">{{ _('Pagamenti online attivi (Mollie): il cliente sceglie il piano e paga dalla pagina Abbonamento; i rinnovi sono automatici.') }}</p>
      {% else %}<p class="lead">{{ _('Pagamenti online non configurati: registra i bonifici da "Abbonamento" di ogni redazione. Per attivarli metti <code>EDITOR_MOLLIE_API_KEY</code> nel <code>.env</code>.') }}</p>{% endif %}
    </section>
  </div>

  <section class="card" id="piani" aria-labelledby="h-plans">
    <div class="card-head"><h2 id="h-plans">{{ _('Piani') }}</h2>
    {% if notice and notice_at == 'piani' %}<p class="notice" role="status" style="margin: 0 16px;">{{ notice }}</p>{% endif %}<span class="hint">{{ _('prezzi IVA esclusa') }}</span></div>
    <div class="pad">
    {% for p in plans %}
    <form method="post" action="/admin/plans/{{ p.code }}" class="form-grid" style="margin-bottom: 16px;">
      <label class="field">{{ _('Nome') }} <span class="num">({{ p.code }})</span><input name="name" value="{{ p.name }}" required></label>
      <label class="field">{{ _('Al mese (€)') }}<input name="price_month" inputmode="decimal" value="{{ '%.2f'|format(p.price_month_cents / 100) if p.price_month_cents is not none else '' }}"></label>
      <label class="field">{{ _("All'anno (€)") }}<input name="price_year" inputmode="decimal" value="{{ '%.2f'|format(p.price_year_cents / 100) if p.price_year_cents is not none else '' }}"></label>
      <label class="field">{{ _('Giorni di prova') }}<input name="trial_days" inputmode="numeric" value="{{ p.trial_days }}"></label>
      <label class="field">{{ _('Siti') }}<input name="max_sites" inputmode="numeric" value="{{ p.max_sites if p.max_sites is not none else '' }}"></label>
      <label class="field">{{ _('Lingue per sito') }}<input name="max_languages" inputmode="numeric" value="{{ p.max_languages if p.max_languages is not none else '' }}"></label>
      <label class="field">{{ _('Fonti attive') }}<input name="max_active_sources" inputmode="numeric" value="{{ p.max_active_sources if p.max_active_sources is not none else '' }}"></label>
      <label class="field">{{ _('Notizie al giorno') }}<input name="max_items_per_day" inputmode="numeric" value="{{ p.max_items_per_day if p.max_items_per_day is not none else '' }}"></label>
      <label class="field">{{ _('Articoli al mese') }}<input name="max_drafts_month" inputmode="numeric" value="{{ p.max_drafts_month if p.max_drafts_month is not none else '' }}"></label>
      <label class="field">{{ _('Descrizione') }}<input name="description" value="{{ p.description }}"></label>
      <label class="field">{{ _('Redazione automatica') }}<select name="autopilot"><option value="1" {% if p.autopilot is not false %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if p.autopilot is false %}selected{% endif %}>{{ _('No') }}</option></select></label>
      <label class="field">{{ _('Sul sito') }}<select name="public"><option value="1" {% if p.public %}selected{% endif %}>{{ _('Sì') }}</option><option value="0" {% if not p.public %}selected{% endif %}>{{ _('No') }}</option></select></label>
      <div><button class="btn" type="submit">{{ _('Salva') }}</button></div>
    </form>
    {% if p.code != 'trial' %}
    <form method="post" action="/admin/plans/{{ p.code }}/delete" style="margin: -8px 0 16px;" onsubmit='return confirm({{ _('Eliminare il piano {name}?', name=p.name)|string|tojson }})'><button class="btn sm danger" type="submit">{{ _('Elimina il piano {name}', name=p.name) }}</button></form>
    {% endif %}
    {% endfor %}
    <form method="post" action="/admin/plans" class="form-grid" style="margin-bottom: 16px;">
      <label class="field">{{ _('Codice del nuovo piano') }}<input name="code" required maxlength="40" pattern="[a-z0-9-]{1,40}" placeholder="pro-plus"></label>
      <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100"></label>
      <div><button class="btn" type="submit">{{ _('Aggiungi un piano') }}</button></div>
    </form>
    <p class="hint">{{ _('Il sito pubblico legge i piani da <code>/api/public/plans</code>. Il piano "Prova" è quello di chi si iscrive.') }}</p>
    </div>
  </section>

  <section class="card pad" id="aggiornamenti" aria-labelledby="h-updates">
    <h2 id="h-updates">{{ _('Aggiornamenti') }}</h2>
    {% if notice and notice_at == 'aggiornamenti' %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
    {% set st = updates.status or {} %}
    {% set av = updates.available or {} %}
    <div class="list-row"><span>{{ _('Versione installata') }}</span><span class="num">{{ updates.installed }}</span></div>
    {% if updates.enabled %}
    <div class="list-row"><span>{{ _('Ultima versione') }}</span><span class="num">{% if av.version %}{% if av.url %}<a href="{{ av.url }}" rel="noopener" target="_blank">{{ av.version }}</a>{% else %}{{ av.version }}{% endif %}{% else %}–{% endif %}</span></div>
    {% if av.checked_at %}<p class="hint">{{ _('Controllata il {date} alle {time}. Il controllo si ripete ogni 6 ore.', date=av.checked_at[8:10] ~ '/' ~ av.checked_at[5:7], time=av.checked_at[11:16] ~ ' UTC') }}{% if av.error %} {{ _('Ultimo controllo non riuscito: {error}', error=av.error) }}{% endif %}</p>{% endif %}
    {% if updates.pending %}
      {% if updates.stale %}<p class="error">{{ _('La richiesta di aggiornamento alla {version} aspetta da più di 5 minuti: sul server lo script update.sh non è installato o il cron non gira (vedi deploy/server/README.md, "Updating from the console").', version=updates.pending.version) }}</p>
      {% else %}<p class="lead">{{ _('Aggiornamento alla {version} chiesto: il server lo prende entro un minuto.', version=updates.pending.version) }}</p>{% endif %}
    {% elif st.state == 'running' %}
      <p class="lead">{{ _('Aggiornamento alla {version} in corso: {step}.', version=st.version, step={'backup': _('backup del database'), 'pull': _('download della versione'), 'restart': _('riavvio'), 'check': _('verifica')}.get(st.step, st.step)) }}</p>
    {% elif updates.newer %}
      <form method="post" action="/admin/updates/apply" onsubmit='return confirm({{ _('Aggiornare alla versione {version}? Prima viene fatto un backup; il pannello resta fermo per qualche secondo.', version=av.version)|string|tojson }})'>
        <input type="hidden" name="version" value="{{ av.version }}">
        <button class="btn pri" type="submit">{{ _('Aggiorna alla {version}', version=av.version) }}</button>
      </form>
      <p class="hint">{{ _('Leggi le note della versione prima di aggiornare: il link è sul numero di versione.') }}</p>
    {% else %}
      <p class="hint">{{ _('Il server è aggiornato.') }}</p>
    {% endif %}
    {% if st.state in ('done', 'failed') %}
      {% if st.state == 'done' %}<p class="hint">{{ _('Ultimo aggiornamento: dalla {old} alla {version}, il {date}.', old=st['from'], version=st.version, date=st.at[8:10] ~ '/' ~ st.at[5:7] ~ ' ' ~ st.at[11:16] ~ ' UTC') }}</p>
      {% else %}<p class="error">{{ _('Aggiornamento alla {version} non riuscito durante: {step}.', version=st.version, step={'backup': _('backup del database'), 'pull': _('download della versione'), 'restart': _('riavvio'), 'check': _('verifica')}.get(st.step, st.step)) }}
        {% if st.step in ('backup', 'pull') %}{{ _('Non è cambiato niente: il server è ancora alla {old}.', old=st['from']) }}{% else %}{{ _('La {version} è installata ma non risponde come dovrebbe: guarda il registro. Il backup fatto prima è nella cartella backup del server.', version=st.version) }}{% endif %}</p>{% endif %}
      {% if updates.log %}<details><summary class="hint">{{ _('Registro') }}</summary><pre style="white-space: pre-wrap; font-size: 12px;">{{ updates.log }}</pre></details>{% endif %}
    {% endif %}
    <form method="post" action="/admin/updates/check" style="margin-top: 8px;"><button class="btn sm" type="submit">{{ _('Controlla adesso') }}</button></form>
    {% else %}
    <p class="hint">{{ _('Per aggiornare da qui serve lo script update.sh sul server: vedi deploy/server/README.md, "Updating from the console". Senza, si aggiorna dal terminale.') }}</p>
    {% endif %}
    {% if installs.seen %}
    <h3 id="installazioni" style="margin-top: 18px;">{{ _('Installazioni di Redazia') }}</h3>
    <p class="hint">{{ _("Ogni installazione chiede a questo server l'ultima versione ogni 6 ore, con un identificativo casuale e la versione installata. Chi ha EDITOR_TELEMETRY=off non viene contato.") }}</p>
    <div class="list-row"><span>{{ _('Attive negli ultimi 7 giorni') }}</span><span class="num">{{ installs.active }}</span></div>
    {% for v, n in installs.versions %}<div class="list-row"><span class="hint">{{ _('versione {version}', version=v) }}</span><span class="num">{{ n }}</span></div>{% endfor %}
    <div class="list-row"><span>{{ _('Nuove negli ultimi 30 giorni') }}</span><span class="num">{{ installs.new_30 }}</span></div>
    <div class="list-row"><span>{{ _('Viste in tutto') }}</span><span class="num">{{ installs.seen }}</span></div>
    {% endif %}
  </section>

  <div class="cols">
    <section class="card pad col-wide" id="operatori" aria-labelledby="h-ops">
      <h2 id="h-ops">{{ _('Amministratori') }}</h2>
      {% for o in operators %}
      <div class="list-row"><span>{{ o.name or o.email }}{% if o.name %} <span class="hint">{{ o.email }}</span>{% endif %}</span><span class="row">{% if not o.password_hash %}<span class="chip amber">{{ _('Invito non accettato') }}</span>{% endif %}{% if o.id != me.user_id %}<form class="inline" method="post" action="/admin/operators/{{ o.id }}/remove" onsubmit='return confirm({{ _('Togliere la console a {email}? Le sue redazioni restano.', email=o.email)|string|tojson }})'><button class="btn sm" type="submit">{{ _('Togli') }}</button></form>{% endif %}</span></div>
      {% endfor %}
      {% for i in pending %}
      <div class="list-row"><span>{{ i.email }}</span><span class="row"><span class="chip">{{ _('Invitato, scade {date}', date=i.expires_at.strftime('%d/%m')) }}</span><form class="inline" method="post" action="/admin/invites/{{ i.token_sha256 }}/revoke"><button class="btn sm" type="submit">{{ _('Annulla') }}</button></form></span></div>
      {% endfor %}
      <form method="post" action="/admin/operators" class="form-grid">
        <label class="field">{{ _('Email') }}<input name="email" type="email" required></label>
        <div><button class="btn" type="submit">{{ _('Invita un amministratore') }}</button></div>
      </form>
      <form method="post" action="/admin/reset" class="form-grid">
        <label class="field">{{ _('Email di un account') }}<input name="email" type="email" required></label>
        <div><button class="btn" type="submit">{{ _('Link per nuova password') }}</button></div>
      </form>
    </section>

    <section class="card pad col-side" id="api" aria-labelledby="h-keys">
      <h2 id="h-keys">{{ _('Chiavi API') }}</h2>
      <p class="hint">{{ _('Per il sistema di pagamento: con una chiave crea, aggiorna e sospende le redazioni da <code>/api/operator/tenants</code>.') }}</p>
      {% for k in keys %}
      <div class="list-row">
        <span>{{ k.name }} <span class="hint">{{ k.created_at.strftime('%d/%m/%Y') if k.created_at else '' }}</span></span>
        {% if k.revoked_at %}<span class="chip">{{ _('Revocata') }}</span>{% else %}<form class="inline" method="post" action="/admin/keys/{{ k.id }}/revoke"><button class="btn sm" type="submit">{{ _('Revoca') }}</button></form>{% endif %}
      </div>
      {% endfor %}
      <form method="post" action="/admin/keys" class="form-grid">
        <label class="field">{{ _('Nome') }}<input name="name" required maxlength="100" placeholder="{{ _('pagamenti') }}"></label>
        <div><button class="btn" type="submit">{{ _('Crea chiave') }}</button></div>
      </form>
    </section>
  </div>
</main>
</div>
</body>
</html>
