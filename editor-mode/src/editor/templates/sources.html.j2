{% extends "base.html.j2" %}
{% block title %}Fonti{% endblock %}
{% block main %}
<header class="head">
  <div>
    <span class="kicker">Fonti{% if site %} · {{ site.domain }}{% endif %}</span>
    <h1>Fonti scoperte dall'agente</h1>
    <p class="lead">Nessuna lista fissa. L'agente trova le fonti in tre modi: le testate che gli articoli del sito citano, le ricerche fatte con le parole chiave dei temi del profilo (Hacker News, GitHub, Hugging Face, arXiv) e le testate che il modello indica per quei temi. Ogni fonte viene letta e giudicata su cosa pubblica; da 0,50 entra attiva, tra 0,35 e 0,50 resta candidata. Ogni lunedì vengono rivalutate.</p>
  </div>
  {% if site and caller.can('owner') %}
  <form class="inline" method="post" action="/ui/sites/{{ site.id }}/discover"><button class="btn pri" type="submit">Cerca nuove fonti</button></form>
  {% endif %}
</header>

{% if not site %}
<section class="card pad"><h2>Nessun sito</h2><p class="lead">Aggiungi un dominio da <a href="/site">Sito e profilo</a> per far partire la scoperta delle fonti.</p></section>
{% else %}
{% set cap = usage.plan.get('max_active_sources') if usage else none %}
<section class="stats" aria-label="Riepilogo fonti">
  <div class="card stat"><span class="label">Attive</span><span class="value">{{ counts.get('active', 0) }}{% if cap %} <small>/ {{ cap }}</small>{% endif %}</span>
    {% if cap %}<div class="bar thin"><i style="width: {{ [100, 100 * counts.get('active', 0) / cap]|min }}%"></i></div>{% else %}<span class="note">nessun tetto nel piano</span>{% endif %}</div>
  <div class="card stat"><span class="label">Candidate</span><span class="value">{{ counts.get('candidate', 0) }}</span><span class="note">sotto la soglia o in attesa di quota</span></div>
  <div class="card stat"><span class="label">Sospese</span><span class="value">{{ counts.get('suspended', 0) }}</span><span class="note {% if counts.get('suspended') %}warn{% endif %}">errori ripetuti o fonte ferma</span></div>
  <div class="card stat"><span class="label">Scartate</span><span class="value">{{ counts.get('rejected', 0) }}</span><span class="note">poco pertinenti al profilo</span></div>
</section>

<nav class="tabs" aria-label="Filtra per stato">
  {% for key, label in [('active', 'Attive'), ('candidate', 'Candidate'), ('suspended', 'Sospese'), ('rejected', 'Scartate'), ('all', 'Tutte')] %}
  <a href="/sources?status={{ key }}" {% if status == key %}class="on" aria-current="page"{% endif %}>{{ label }} <span class="num">{{ total if key == 'all' else counts.get(key, 0) }}</span></a>
  {% endfor %}
</nav>

<section class="card" aria-label="Elenco fonti">
  {% if rows %}
  <div class="scroll">
    <table style="min-width: 760px;">
      <thead><tr><th>Fonte</th><th>Origine</th><th>Punteggio</th><th>Pertinenza</th><th>Ultima notizia</th><th>Stato</th>{% if caller.can('owner') %}<th><span class="sr">Azioni</span></th>{% endif %}</tr></thead>
      <tbody>
      {% for r in rows %}
      {% set comp = (r.evaluation or {}).get('components') or {} %}
      <tr {% if r.status in ('suspended', 'rejected') %}class="off"{% endif %}>
        <td style="max-width: 280px; overflow-wrap: anywhere;"><strong>{{ r.name }}</strong> <span class="chip">{{ kinds.get(r.kind, r.kind) }}</span><small>{{ r.url|replace('https://', '')|replace('http://', '') }}</small></td>
        {% set evd = r.evidence or {} %}
        <td style="max-width: 300px;">{{ origins.get(r.origin, r.origin or '–') }}
          <small>{% if r.origin == 'site_outbound' %}citata {{ evd.get('cited_by_site', 0) }} {{ 'volta' if evd.get('cited_by_site') == 1 else 'volte' }} negli articoli del sito
          {% elif r.origin == 'api_query' and evd.get('query') %}trovata cercando «{{ evd.get('query') }}» su {{ kinds.get(r.kind, r.kind) }}
          {% elif r.origin == 'api_query' and evd.get('categories') %}categorie arXiv dei temi: {{ evd.get('categories')|join(', ') }}
          {% elif r.origin == 'api_query' and evd.get('matched') %}i temi parlano di {{ evd.get('matched')|join(', ') }}
          {% elif r.origin == 'model_suggestion' %}indicata dal modello per i temi del sito{% if evd.get('domain') %} ({{ evd.get('domain') }}){% endif %}, feed letto e verificato
          {% endif %}</small>
          {% set ex = latest.get(r.id) or (r.evaluation or {}).get('examples') or [] %}
          {% if ex %}<details><summary class="hint">{{ 'Ultime notizie' if latest.get(r.id) else 'Cosa pubblicava alla valutazione' }}</summary>
            {% for e in ex %}<small style="display: block;"><a href="{{ e.url }}" rel="noopener noreferrer" target="_blank">{{ e.title }}</a></small>{% endfor %}
          </details>{% endif %}
        </td>
        <td>
          {% if r.score is not none %}
          <div class="row" style="flex-wrap: nowrap;"><div class="bar" style="width: 72px;"><i style="width: {{ (100 * r.score)|round|int }}%"></i></div><span class="num">{{ r.score|num }}</span></div>
          {% else %}<span class="flat">–</span>{% endif %}
        </td>
        <td class="num">{% if comp.get('relevance') is not none %}{{ comp.get('relevance')|num }}{% else %}–{% endif %}</td>
        <td>{{ when(r.last_item_at, 'day') }}</td>
        <td>
          {% set st = {'active': ('green', 'Attiva'), 'candidate': ('blue', 'Candidata'), 'suspended': ('red', 'Sospesa'), 'rejected': ('', 'Scartata')}.get(r.status, ('', r.status)) %}
          <span class="chip {{ st[0] }}">{{ st[1] }}</span>
          {% if r.status_reason and r.status != 'active' %}<small>{{ r.status_reason }}</small>
          {% elif r.status == 'rejected' and comp.get('relevance') is not none and comp.get('relevance') < 0.1 %}<small>parla poco dei temi del sito</small>
          {% elif r.status == 'rejected' %}<small>punteggio sotto 0,35</small>{% endif %}
          {% if comp %}<details><summary class="hint">Perché questo punteggio</summary>
            <small style="display: block;">pertinenza {{ comp.get('relevance', 0)|num }} · frequenza {{ comp.get('frequency', 0)|num }} · freschezza {{ comp.get('freshness', 0)|num }} · originalità {{ comp.get('originality', 0)|num }} · qualità {{ comp.get('quality', 0)|num }} · affidabilità {{ comp.get('reliability', 0)|num }}</small>
          </details>{% endif %}
        </td>
        {% if caller.can('owner') %}
        <td>
          <div class="row" style="flex-wrap: nowrap; justify-content: flex-end;">
            {% if r.status != 'active' %}
            <form class="inline" method="post" action="/ui/sources/{{ r.id }}/status"><input type="hidden" name="status" value="active"><input type="hidden" name="back" value="/sources?status={{ status }}"><button class="btn sm" type="submit">Attiva</button></form>
            {% endif %}
            {% if r.status == 'active' %}
            <form class="inline" method="post" action="/ui/sources/{{ r.id }}/status"><input type="hidden" name="status" value="suspended"><input type="hidden" name="back" value="/sources?status={{ status }}"><button class="btn sm" type="submit">Sospendi</button></form>
            {% endif %}
            {% if r.status != 'rejected' %}
            <form class="inline" method="post" action="/ui/sources/{{ r.id }}/status"><input type="hidden" name="status" value="rejected"><input type="hidden" name="back" value="/sources?status={{ status }}"><button class="btn sm" type="submit">Scarta</button></form>
            {% endif %}
          </div>
        </td>
        {% endif %}
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty">Nessuna fonte in questo stato.</p>
  {% endif %}
</section>
<p class="hint">Il punteggio pesa pertinenza ai temi del profilo (35%), frequenza (15%), freschezza (15%), qualità (15%), originalità (10%) e affidabilità (10%). Pertinenza: quante notizie della fonte contengono le parole chiave dei temi.</p>
{% endif %}
{% endblock %}
