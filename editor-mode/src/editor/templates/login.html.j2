<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Accedi · EuLLM Editor</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="EuLLM" width="130" height="36"><small>Editor Mode</small></div>
  {% if setup %}
  <section class="card pad" style="border-color: var(--accent);">
    <h2>Prima configurazione</h2>
    <p class="lead">Non c'è ancora un amministratore. Sul server, nella cartella dell'installazione, lancia
    <code>docker compose exec editor-web editor setup-link</code> e apri il link che stampa: lì crei il tuo account.</p>
  </section>
  {% endif %}
  <section class="card pad">
    <h1 style="font-size: 22px;">Accedi</h1>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/login" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">Email<input name="email" type="email" autocomplete="username" value="{{ email or '' }}" required autofocus></label>
      <label class="field">Password<input name="password" type="password" autocomplete="current-password" required></label>
      <button class="btn pri" type="submit">Entra</button>
    </form>
    {% if can_reset %}<a class="hint" href="/forgot">Password dimenticata?</a>{% else %}<p class="hint">Password dimenticata? Chiedi un nuovo link a chi gestisce il servizio.</p>{% endif %}
  </section>
  <details class="card pad">
    <summary class="hint">Entra con un token di accesso</summary>
    <form method="post" action="/login" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">Token<input name="token" type="password" autocomplete="off" required></label>
      <button class="btn" type="submit">Entra con il token</button>
    </form>
  </details>
  <p class="hint">Resti collegato su questo browser per 30 giorni, finché non esci.</p>
</main>
</body>
</html>
