<!doctype html>
<html lang="{{ lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _('Accedi') }} · Redazia</title>
<link rel="icon" type="image/png" href="/static/redazia-icon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/redazia-logo.webp" alt="Redazia" width="111" height="36"></div>
  {% if setup %}
  <section class="card pad" style="border-color: var(--accent);">
    <h2>{{ _('Prima configurazione') }}</h2>
    <p class="lead">{{ _("Non c'è ancora un amministratore. Sul server, nella cartella dell'installazione, lancia <code>docker compose exec editor-web editor setup-link</code> e apri il link che stampa: lì crei il tuo account.") }}</p>
  </section>
  {% endif %}
  <section class="card pad">
    <h1 style="font-size: 22px;">{{ _('Accedi') }}</h1>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/login" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">{{ _('Email') }}<input name="email" type="email" autocomplete="username" value="{{ email or '' }}" required autofocus></label>
      <label class="field">{{ _('Password') }}<input name="password" type="password" autocomplete="current-password" required></label>
      <button class="btn pri" type="submit">{{ _('Entra') }}</button>
    </form>
    {% if can_reset %}<a class="hint" href="/forgot">{{ _('Password dimenticata?') }}</a>{% else %}<p class="hint">{{ _('Password dimenticata? Chiedi un nuovo link a chi gestisce il servizio.') }}</p>{% endif %}
  </section>
  <details class="card pad">
    <summary class="hint">{{ _('Entra con un token di accesso') }}</summary>
    <form method="post" action="/login" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">{{ _('Token') }}<input name="token" type="password" autocomplete="off" required></label>
      <button class="btn" type="submit">{{ _('Entra con il token') }}</button>
    </form>
  </details>
  <p class="hint">{{ _('Resti collegato su questo browser per 30 giorni, finché non esci.') }}</p>
  {% include "_lang.html.j2" %}
</main>
</body>
</html>
