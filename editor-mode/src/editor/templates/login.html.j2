<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Accedi · EuLLM Editor</title>
<link rel="icon" type="image/png" href="/static/favicon.png">
{% include "_style.html.j2" %}
</head>
<body>
<main class="solo">
  <div class="brand"><img class="logo" src="/static/logo.webp" alt="EuLLM" width="130" height="36"><small>Editor Mode</small></div>
  <section class="card pad">
    <h1 style="font-size: 22px;">Accedi</h1>
    <p class="lead">Usa il token di accesso che ti ha dato l'owner del tuo account.</p>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/login" style="display: flex; flex-direction: column; gap: 12px;">
      <label class="field">Token<input name="token" type="password" autocomplete="current-password" required autofocus></label>
      <button class="btn pri" type="submit">Entra</button>
    </form>
  </section>
  <p class="hint">Il token resta in un cookie di sessione su questo browser per 30 giorni.</p>
</main>
</body>
</html>
